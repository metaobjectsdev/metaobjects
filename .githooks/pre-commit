#!/usr/bin/env bash
#
# metaobjects is a PUBLIC repository.
# Block commits that leak absolute local paths, or private/other-project names.
#
# IMPORTANT: this committed hook names NO private project. The structural
# patterns below are generic (home paths). Private project names live ONLY in an
# UNTRACKED local denylist so the guard itself never becomes a leak:
#
#     .githooks/deny-list.local      (gitignored; one regex per line; you create it)
#     .githooks/deny-list.example    (committed template, placeholders only)
#
# Activate (one-time, per clone):  git config core.hooksPath .githooks
#                                  cp .githooks/deny-list.example .githooks/deny-list.local
#                                  # then edit deny-list.local with the real names
# Bypass (discouraged):            git commit --no-verify
#
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo .)"
# Patterns, allow-list and diff filter are shared with .githooks/leak-scan.sh.
# shellcheck source=leak-patterns.sh
. "$ROOT/.githooks/leak-patterns.sh"
PATTERNS="$LEAK_PATTERNS"
ALLOW="$LEAK_ALLOW"

# Merge in private-name patterns from a denylist. Source priority:
#   1) git config hooks.denyListPath  -> point at your private denylist file (kept in a private repo)
#   2) .githooks/deny-list.local      -> untracked local file or symlink
# If neither resolves, only the generic structural patterns above are enforced.
DENY_FILE="$(git config --get hooks.denyListPath 2>/dev/null || true)"
[ -z "$DENY_FILE" ] && DENY_FILE="$ROOT/.githooks/deny-list.local"
if [ -f "$DENY_FILE" ]; then
  extra=$(grep -vE '^[[:space:]]*(#|$)' "$DENY_FILE" | paste -sd'|' -)
  [ -n "$extra" ] && PATTERNS="$PATTERNS|$extra"
fi

# Scan only newly-ADDED staged lines, attributed to their file; skip the hooks dir.
hits=$(git diff --cached --diff-filter="$LEAK_DIFF_FILTER" -U0 --no-color 2>/dev/null | awk '
  /^\+\+\+ /              { f=$2; sub(/^b\//,"",f); next }
  /^\+/ && !/^\+\+\+/     { if (f !~ /^\.githooks\//) print f "\t" substr($0,2) }
' | grep -Ei "$PATTERNS" | grep -vEi "$ALLOW")

# A pre-release version must never be committed: scripts/release.mjs derives the lockstep
# set from the CLI's CURRENT version, so a stray -rc.N silently shrinks the next release.
# Only runs when a version-bearing file is actually staged.
if git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep -qE \
     '(package\.json|pom\.xml|pyproject\.toml|Directory\.Build\.props)$'; then
  if [ -x "$ROOT/scripts/check-no-prerelease-versions.sh" ]; then
    if ! "$ROOT/scripts/check-no-prerelease-versions.sh" >/dev/null 2>&1; then
      echo "" >&2
      "$ROOT/scripts/check-no-prerelease-versions.sh" >&2 || true
      echo "  commit blocked — see above. Bypass (discouraged):  git commit --no-verify" >&2
      exit 1
    fi
  fi
fi

if [ -n "$hits" ]; then
  echo "" >&2
  echo "  commit blocked — possible private/other-project or local-path leak (metaobjects is PUBLIC):" >&2
  echo "$hits" | sed 's/^/      /' >&2
  echo "" >&2
  echo "  Genericize the references (e.g. 'a downstream consumer', '<repo-root>')" >&2
  echo "  — see CLAUDE.md -> Public repository hygiene." >&2
  echo "  False positive? Bypass with:  git commit --no-verify" >&2
  echo "" >&2
  exit 1
fi
exit 0
