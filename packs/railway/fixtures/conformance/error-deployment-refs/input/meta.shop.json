{
  "metadata.root": {
    "package": "acme::shop",
    "children": [
      {
        "system.internal": {
          "name": "Shop",
          "children": [
            {
              "app.service": {
                "name": "api",
                "@needs": [
                  "db"
                ],
                "@calls": [
                  "Payments"
                ]
              }
            },
            {
              "resource.database": {
                "name": "db",
                "@engine": "postgres"
              }
            },
            {
              "system.external": {
                "name": "Payments"
              }
            }
          ]
        }
      },
      {
        "environment.standing": {
          "name": "production"
        }
      },
      {
        "deployment.railway": {
          "name": "api-production",
          "@app": "Shop.db",
          "@environment": "prod",
          "@project": "shop"
        }
      }
    ]
  }
}
