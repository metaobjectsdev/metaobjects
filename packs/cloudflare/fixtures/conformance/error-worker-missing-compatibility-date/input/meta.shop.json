{ "metadata.root": { "package": "acme::shop", "children": [
  { "system.internal": { "name": "Shop", "children": [
    { "app.service": { "name": "site", "@needs": ["db"], "children": [ { "build.static": { "name": "assets", "@directory": "public" } } ] } },
    { "resource.database": { "name": "db" } } ] } },
  { "environment.standing": { "name": "production" } },
  { "deployment.worker": { "name": "siteBase", "abstract": true, "@app": "Shop.site", "@tokenSecret": "ACME_WORKERS_TOKEN" } },
  { "deployment.worker": { "name": "siteProduction", "extends": "siteBase", "@environment": "production" } }
]}}
