    },
    {
      "name": "LOGIN_LOCKOUT_LIMITER",
      "namespace_id": "1004",
      "simple": {
        "limit": 4,
        "period": 60
      }
    },
    {
      "name": "RECOVERY_LIMITER",
      "namespace_id": "1005",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ]
