      "binding": "DB",
      "database_name": "trips",
      "database_id": "00000000-0000-4000-8000-000000000003",
      "migrations_dir": ".metaobjects/migrations"
    }
  ],
  // no cloudflare.kv binding
  "kv_namespaces": [],
  // cloudflare.r2 photos
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "trips-photos"
    }
  ],
  // no cloudflare.queue binding
  "queues": {
    "producers": []
  },
  // cloudflare.ratelimit enterLimiter
  // cloudflare.ratelimit adminLimiter
  // cloudflare.ratelimit loginLimiter
  // cloudflare.ratelimit loginLockoutLimiter
  // cloudflare.ratelimit recoveryLimiter
  "ratelimits": [
    {
      "name": "ENTER_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "ADMIN_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 200,
        "period": 60
