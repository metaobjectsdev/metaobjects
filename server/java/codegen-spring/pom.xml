<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
<modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.metaobjects</groupId>
        <artifactId>metaobjects</artifactId>
        <version>8.0.7</version>
    </parent>

    <artifactId>metaobjects-codegen-spring</artifactId>
    <packaging>jar</packaging>

    <name>MetaObjects :: Codegen :: Spring</name>
    <description>Spring Web MVC codegen target — emits @RestController per entity + DTO records + Repository interface (FR-008 §2.1). Targets Spring Boot 3.x / Java 21. Hand-rolled string emission; no Spring runtime dependency.</description>

    <dependencies>
        <!-- production -->
        <dependency>
            <groupId>com.metaobjects</groupId>
            <artifactId>metaobjects-codegen-base</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.metaobjects</groupId>
            <artifactId>metaobjects-metadata</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- compile scope: SpringRenderHelperGenerator runs the mustache-VO drift
             gate (Verify.check + FilesystemProvider + PayloadField) at CODEGEN time,
             so codegen-spring genuinely compiles against the render engine. -->
        <dependency>
            <groupId>com.metaobjects</groupId>
            <artifactId>metaobjects-render</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- test -->
        <dependency>
            <groupId>com.metaobjects</groupId>
            <artifactId>metaobjects-metadata</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.metaobjects</groupId>
            <artifactId>metaobjects-codegen-base</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>


        <!-- compile-and-run test: the runtime-delegating extractLenient(MetaDataLoader, String)
             overload delegates to com.metaobjects.object.extract.MetaObjectExtractor (om).
             om transitively brings render + metadata onto the test classpath. -->
        <dependency>
            <groupId>com.metaobjects</groupId>
            <artifactId>metaobjects-om</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- compile-and-run test: the generated <Entity>TraceHelper references the Slice-1
             OMDB recorder seam (com.metaobjects.manager.db.ai.LlmCallRecorder / LlmCallInput /
             LlmTraceRowBuilder) by FQN string. omdb brings om + render + metadata transitively
             onto the test classpath so the emitted helper compiles. -->
        <dependency>
            <groupId>com.metaobjects</groupId>
            <artifactId>metaobjects-omdb</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- compile-and-run test: generated parser imports Jackson ObjectMapper -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- validation-conformance runner: validate the generated DTO via a jakarta Validator.
             Hibernate Validator brings jakarta.validation-api transitively; expressly is the
             jakarta EL implementation the constraint-message interpolator needs at runtime. -->
        <dependency>
            <groupId>org.hibernate.validator</groupId>
            <artifactId>hibernate-validator</artifactId>
            <version>8.0.1.Final</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.glassfish.expressly</groupId>
            <artifactId>expressly</artifactId>
            <version>5.0.0</version>
            <scope>test</scope>
        </dependency>

        <!-- compile-and-run test (GeneratedTphM2mTraversalCompileRunTest): the generated TPH
             @RestController's per-subtype M:N traversal endpoint composes
             repository.findByIdAndType(...) itself now (the enforcement moved off the
             repository interface's javadoc and into generated code), so proving that requires
             actually compiling + directly invoking the emitted controller class — no Spring
             context boot, no HTTP dispatch, just `new AuthController(...)` + a method call.
             spring-web alone supplies the annotation types (@RestController/@GetMapping/…) plus
             ResponseEntity/HttpStatus; the full spring-webmvc/spring-test MockMvc harness that
             exercises the real HTTP lane lives in the separate integration-tests module (SP-F). -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <version>6.2.11</version>
            <scope>test</scope>
        </dependency>
        <!-- jakarta servlet: the generated controller's list() takes HttpServletRequest, so the
             whole file needs this on the classpath to compile even though this test never calls
             that method. -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.0.0</version>
            <scope>test</scope>
        </dependency>

        <!-- Inherited from parent POM: SLF4J, JUnit 4, Logback -->
    </dependencies>

    <build>
        <plugins>
            <!-- `mvn metaobjects:eject` (FR — eject in every port, JVM section) ships the
                 verbatim source of every ejectable generator inside the jar that owns it,
                 as a classpath resource under META-INF/metaobjects/reference/java/. Copied
                 at BUILD TIME from the same src/main/java files the compiler just compiled
                 — never a second, hand-maintained copy — so there is nothing to drift: the
                 resource IS the source, one file, one owner. See
                 com.metaobjects.generator.GeneratorRegistry.EJECT_RESOURCE_ROOT.

                 Deliberately excludes "extractor" (ExtractorCodeGenerator — fused into
                 "entity", not separately wirable) and "template" (TemplateScopeGenerator —
                 a generic declarative primitive with no emit logic to own); see
                 GeneratorRegistry's javadoc on those two entries. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>ship-eject-reference-source</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF/metaobjects/reference/java</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>src/main/java/com/metaobjects/generator/spring</directory>
                                    <includes>
                                        <include>SpringControllerGenerator.java</include>
                                        <include>SpringOutputParserGenerator.java</include>
                                        <include>SpringOutputPromptGenerator.java</include>
                                        <include>SpringRenderHelperGenerator.java</include>
                                        <include>SpringFilterAllowlistGenerator.java</include>
                                        <include>SpringRepositoryGenerator.java</include>
                                        <include>SpringDtoGenerator.java</include>
                                        <include>SpringValueObjectGenerator.java</include>
                                        <include>LlmTraceHelperGenerator.java</include>
                                        <include>SpringNamesGenerator.java</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <!-- The helper runtime the generated controller / DTO / repository import
                         (GeneratorRegistry.RUNTIME_PACKAGE). Eject copies the classes a
                         generator's GeneratorInfo.ejectRuntime() names into the adopter's module
                         beside the generator, so an owned generator's output never imports this
                         jar. M2mJoinResolver is not here: no generated file imports it. -->
                    <execution>
                        <id>ship-eject-runtime-source</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF/metaobjects/reference/java/runtime</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>src/main/java/com/metaobjects/generator/spring/runtime</directory>
                                    <includes>
                                        <include>ConstraintErrors.java</include>
                                        <include>FilterParseResult.java</include>
                                        <include>FilterParser.java</include>
                                        <include>FilterPredicate.java</include>
                                        <include>PatchValidationException.java</include>
                                        <include>RecordComponentNames.java</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
