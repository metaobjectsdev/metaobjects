<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.metaobjects</groupId>
    <artifactId>metaobjects</artifactId>
    <version>7.24.4</version>
  </parent>

  <artifactId>metaobjects-integration-tests</artifactId>
  <name>MetaObjects :: Cross-Language Persistence Conformance (Java)</name>
  <description>
    On-demand integration suite driving the shared fixtures/persistence-conformance
    corpus through Java's metadata loader + SchemaMigrationEngine + ObjectManagerDB
    against an ephemeral Postgres testcontainer. Mirrors the C# and TS runners.

    Intentionally NOT registered as a module in the parent pom — keeps the
    default reactor build (`mvn test`) docker-free. Invoke explicitly via
    `mvn -f server/java/integration-tests/pom.xml test` or scripts/integration-test.sh.
  </description>

  <properties>
    <postgres.jdbc.version>42.7.4</postgres.jdbc.version>
    <snakeyaml.version>2.3</snakeyaml.version>
    <jackson.version>2.18.2</jackson.version>
    <spring.version>6.2.11</spring.version>
  </properties>

  <dependencies>
    <!-- The full ports we're exercising end-to-end -->
    <dependency>
      <groupId>com.metaobjects</groupId>
      <artifactId>metaobjects-metadata</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.metaobjects</groupId>
      <artifactId>metaobjects-om</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.metaobjects</groupId>
      <artifactId>metaobjects-omdb</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- SP-F generated-controller lane: generate + compile + host the EMITTED
         Spring @RestController for Author against the api-contract corpus.
         codegen-spring supplies the generators + the controller runtime types
         (FilterPredicate / FilterParser / FilterParseResult). -->
    <dependency>
      <groupId>com.metaobjects</groupId>
      <artifactId>metaobjects-codegen-spring</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- Spring Web MVC + Spring Test (MockMvc standaloneSetup hosts the generated
         controller in-process — no Spring Boot context, no socket). -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-webmvc</artifactId>
      <version>${spring.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-test</artifactId>
      <version>${spring.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- jakarta servlet (the generated controller's list() takes HttpServletRequest
         so the bracketed filter[...] grammar reaches FilterParser intact). -->
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <version>6.0.0</version>
      <scope>test</scope>
    </dependency>

    <!-- jakarta validation: the generated controller annotates the request body
         with @Valid; hibernate-validator + expressly provide a Validator + EL. -->
    <dependency>
      <groupId>org.hibernate.validator</groupId>
      <artifactId>hibernate-validator</artifactId>
      <version>8.0.1.Final</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.glassfish.expressly</groupId>
      <artifactId>expressly</artifactId>
      <version>5.0.0</version>
      <scope>test</scope>
    </dependency>

    <!-- JSR-310 datatypes: the generated AuthorDto types field.timestamp as
         java.time.Instant; the JavaTimeModule lets the host's ObjectMapper
         (de)serialize it. -->
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
      <version>${jackson.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- Postgres JDBC. Containers are spun up via the `docker` CLI directly
         (see PostgresContainer.java) — testcontainers-java's docker-java
         dependency hardcodes an API version too old for current Docker daemons. -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>${postgres.jdbc.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- JUnit 5 (parameterized tests) -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-params</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>

    <!-- YAML scenario loading + canonical-JSON row comparison -->
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <version>${snakeyaml.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.plugin.version}</version>
      </plugin>
    </plugins>
  </build>
</project>
