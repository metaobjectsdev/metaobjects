<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
<modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.metaobjects</groupId>
        <artifactId>metaobjects</artifactId>
        <version>8.1.0</version>
    </parent>
  
    <artifactId>metaobjects-codegen-plantuml</artifactId>
    <packaging>jar</packaging>

    <name>MetaObjects :: Code Generation :: PlantUML</name>
    <description>PlantUML diagram generation for MetaObjects</description>

    <dependencies>
        <dependency>
            <groupId>com.metaobjects</groupId>
            <artifactId>metaobjects-codegen-base</artifactId>
            <version>${project.version}</version>
        </dependency>
        
        <!-- Test Dependencies -->
        <dependency>
            <groupId>com.metaobjects</groupId>
            <artifactId>metaobjects-metadata</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.metaobjects</groupId>
            <artifactId>metaobjects-codegen-base</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        
        <!-- Inherited from parent POM: SLF4J, JUnit, Logback -->
    </dependencies>

    <build>
        <plugins>
            <!-- `mvn metaobjects:eject` ships the verbatim source of every ejectable generator
                 inside the jar that owns it, as a classpath resource under
                 META-INF/metaobjects/reference/java/ (see codegen-spring's pom for the same
                 execution). "plantuml" is the generator and the writer that emits its file;
                 eject copies both into one owned package. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>ship-eject-reference-source</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF/metaobjects/reference/java</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>src/main/java/com/metaobjects/generator/direct/plantuml</directory>
                                    <includes>
                                        <include>PlantUMLGenerator.java</include>
                                        <include>PlantUMLWriter.java</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>