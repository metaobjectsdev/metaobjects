{
  "metadata.root": {
    "package": "examples",
    "children": [
      {
        "object.entity": {
          "name": "Customer",
          "children": [
            {
              "field.long": {
                "name": "id",
                "@required": true
              }
            },
            {
              "field.string": {
                "name": "name",
                "@maxLength": 100,
                "@required": true
              }
            },
            {
              "field.string": {
                "name": "email",
                "@maxLength": 255,
                "@required": true
              }
            },
            {
              "relationship.composition": {
                "name": "profile",
                "@cardinality": "one",
                "@description": "One-to-One Composition: Customer owns exactly one profile (dependent lifecycle)",
                "@referencedBy": "profileId",
                "@objectRef": "CustomerProfile"
              }
            },
            {
              "relationship.composition": {
                "name": "addresses",
                "@cardinality": "many",
                "@description": "One-to-Many Composition: Customer owns multiple addresses (dependent lifecycle)",
                "@referencedBy": "addressIds",
                "@objectRef": "Address"
              }
            },
            {
              "relationship.association": {
                "name": "preferredStore",
                "@cardinality": "one",
                "@description": "One-to-One Association: Customer references a preferred store (independent lifecycle)",
                "@referencedBy": "preferredStoreId",
                "@objectRef": "Store"
              }
            },
            {
              "relationship.association": {
                "name": "favoriteProducts",
                "@cardinality": "many",
                "@description": "One-to-Many Association: Customer references multiple favorite products (independent lifecycle)",
                "@referencedBy": "favoriteProductIds",
                "@objectRef": "Product"
              }
            }
          ]
        }
      },
      {
        "object.entity": {
          "name": "CustomerProfile",
          "children": [
            {
              "field.long": {
                "name": "id",
                "@required": true
              }
            },
            {
              "field.string": {
                "name": "firstName",
                "@maxLength": 50
              }
            },
            {
              "field.string": {
                "name": "lastName",
                "@maxLength": 50
              }
            },
            {
              "field.string": {
                "name": "phoneNumber",
                "@maxLength": 20
              }
            },
            {
              "field.date": {
                "name": "birthDate"
              }
            }
          ]
        }
      },
      {
        "object.entity": {
          "name": "Address",
          "children": [
            {
              "field.long": {
                "name": "id",
                "@required": true
              }
            },
            {
              "field.string": {
                "name": "street",
                "@maxLength": 255,
                "@required": true
              }
            },
            {
              "field.string": {
                "name": "city",
                "@maxLength": 100,
                "@required": true
              }
            },
            {
              "field.string": {
                "name": "zipCode",
                "@maxLength": 20
              }
            },
            {
              "field.string": {
                "name": "type",
                "@maxLength": 20
              }
            }
          ]
        }
      },
      {
        "object.entity": {
          "name": "Store",
          "children": [
            {
              "field.long": {
                "name": "id",
                "@required": true
              }
            },
            {
              "field.string": {
                "name": "name",
                "@maxLength": 100,
                "@required": true
              }
            },
            {
              "field.string": {
                "name": "location",
                "@maxLength": 255
              }
            }
          ]
        }
      },
      {
        "object.entity": {
          "name": "Product",
          "children": [
            {
              "field.long": {
                "name": "id",
                "@required": true
              }
            },
            {
              "field.string": {
                "name": "name",
                "@maxLength": 255,
                "@required": true
              }
            },
            {
              "field.string": {
                "name": "description",
                "@maxLength": 1000
              }
            },
            {
              "field.decimal": {
                "name": "price",
                "@required": true
              }
            }
          ]
        }
      }
    ]
  }
}
