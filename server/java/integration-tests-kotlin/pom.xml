<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.metaobjects</groupId>
    <artifactId>metaobjects</artifactId>
    <version>7.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>metaobjects-integration-tests-kotlin</artifactId>
  <name>MetaObjects :: Cross-Language Persistence Conformance (Kotlin/Exposed)</name>
  <description>
    On-demand integration suite driving a subset of the shared
    fixtures/persistence-conformance corpus through the Kotlin codegen target's
    runtime substrate — JetBrains Exposed against an ephemeral Postgres
    docker container. Mirrors the sibling Java (ObjectManagerDB) runner.

    Intentionally NOT registered as a module in the parent pom — keeps the
    default reactor build (`mvn test`) docker-free. Invoke explicitly via
    `mvn -f server/java/integration-tests-kotlin/pom.xml test`.
  </description>

  <properties>
    <kotlin.version>2.0.21</kotlin.version>
    <exposed.version>0.55.0</exposed.version>
    <postgres.jdbc.version>42.7.4</postgres.jdbc.version>
    <snakeyaml.version>2.3</snakeyaml.version>
    <jackson.version>2.18.2</jackson.version>
    <maven.compiler.release>21</maven.compiler.release>
  </properties>

  <dependencies>
    <!-- Kotlin -->
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
      <version>${kotlin.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- Exposed (Kotlin SQL DSL) -->
    <dependency>
      <groupId>org.jetbrains.exposed</groupId>
      <artifactId>exposed-core</artifactId>
      <version>${exposed.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.exposed</groupId>
      <artifactId>exposed-jdbc</artifactId>
      <version>${exposed.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.exposed</groupId>
      <artifactId>exposed-java-time</artifactId>
      <version>${exposed.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- Metadata loader (test-scope; used to load the canonical corpus for the codegen-matches test). -->
    <dependency>
      <groupId>com.metaobjects</groupId>
      <artifactId>metaobjects-metadata</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Codegen-kotlin: the generator under test in KotlinCodegenMatchesReferenceTest. -->
    <dependency>
      <groupId>com.metaobjects</groupId>
      <artifactId>metaobjects-codegen-kotlin</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- Postgres JDBC. Containers are spun up via the `docker` CLI directly
         (see PostgresContainer.kt) — testcontainers-java's docker-java
         dependency hardcodes an API version too old for current Docker daemons. -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>${postgres.jdbc.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- JUnit 5 (parameterized tests) -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-params</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-test-junit5</artifactId>
      <version>${kotlin.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- YAML scenario loading + canonical-JSON row comparison -->
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <version>${snakeyaml.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <testSourceDirectory>src/test/kotlin</testSourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.jetbrains.kotlin</groupId>
        <artifactId>kotlin-maven-plugin</artifactId>
        <version>${kotlin.version}</version>
        <executions>
          <execution>
            <id>test-compile</id>
            <phase>test-compile</phase>
            <goals><goal>test-compile</goal></goals>
          </execution>
        </executions>
        <configuration>
          <jvmTarget>21</jvmTarget>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.plugin.version}</version>
      </plugin>
    </plugins>
  </build>
</project>
