<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
<modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.metaobjects</groupId>
        <artifactId>metaobjects</artifactId>
        <version>8.1.4</version>
    </parent>
  
    <artifactId>metaobjects-codegen-base</artifactId>
    <packaging>jar</packaging>

    <name>MetaObjects :: Code Generation :: Base</name>
    <description>Base code generation framework for MetaObjects</description>

    <dependencies>
        <dependency>
            <groupId>com.metaobjects</groupId>
            <artifactId>metaobjects-metadata</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Render engine — reused (NOT reimplemented) by the shared, Maven-free
             TemplateVerify helper: the {{field}}<->payload field-tree drift check
             (com.metaobjects.render.Verify) + FilesystemProvider ref resolution.
             render is a leaf module (no metaobjects dependency), so this adds no cycle. -->
        <dependency>
            <groupId>com.metaobjects</groupId>
            <artifactId>metaobjects-render</artifactId>
            <version>${project.version}</version>
        </dependency>


        <!-- JSON Dependencies for Code Generation -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.13.1</version>
        </dependency>

        <!-- Test Dependencies -->
        <dependency>
            <groupId>com.metaobjects</groupId>
            <artifactId>metaobjects-metadata</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>

        <!-- Schema Validation Dependencies for Testing -->
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>1.5.1</version>
            <scope>test</scope>
        </dependency>

        <!--
          Test-only: the generated <Name>Extractor references the Phase-B runtime extract
          (com.metaobjects.object.extract.MetaObjectExtractor in metaobjects-om, returning
          com.metaobjects.render.extract.ExtractionResult). codegen-base MAIN keeps NO om
          dependency (the generator emits that reference as an FQN string only); but the
          flavor compile-run tests now emit + COMPILE that Extractor, so the test classpath
          needs om (which transitively brings render + metadata). No cycle: om depends on
          render + metadata, never on codegen-base.
        -->
        <dependency>
            <groupId>com.metaobjects</groupId>
            <artifactId>metaobjects-om</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Inherited from parent POM: SLF4J, JUnit, Logback -->
    </dependencies>

    <build>
        <plugins>
            <!-- Maven Jar Plugin for test-jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${jar.plugin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- `mvn metaobjects:eject` ships the verbatim source of every ejectable generator
                 inside the jar that owns it, as a classpath resource under
                 META-INF/metaobjects/reference/java/ (see codegen-spring's pom for the same
                 execution, and com.metaobjects.generator.GeneratorRegistry.EJECT_RESOURCE_ROOT).
                 Copied at BUILD TIME from the src/main/java files the compiler just compiled,
                 so the resource IS the source: one file, one owner, nothing to drift.

                 These are "entity" (JavaObjectCodeGenerator), "extractor"
                 (ExtractorCodeGenerator), "html-docs", "ai-docs" and "json-schema", and the rest
                 of their emit, which eject copies
                 with them into the same owned package (GeneratorInfo.ejectWith(), ADR-0034
                 Amendment 6): the generator bases and the writers that emit the class body
                 for "entity", and the writer "extractor" reads its names from. "template"
                 (TemplateScopeGenerator) is not shipped: it is the Mustache primitive and
                 has no emit logic of its own. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>ship-eject-reference-source</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF/metaobjects/reference/java</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>src/main/java/com/metaobjects/generator/direct/object/javacode</directory>
                                    <includes>
                                        <include>JavaObjectCodeGenerator.java</include>
                                        <include>ExtractorCodeGenerator.java</include>
                                        <include>JavaCodeGenerator.java</include>
                                        <include>JavaCodeWriter.java</include>
                                        <include>PojoAwareCodeWriter.java</include>
                                        <include>ValueObjectCodeWriter.java</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <directory>src/main/java/com/metaobjects/generator/direct/object</directory>
                                    <includes>
                                        <include>BaseObjectCodeGenerator.java</include>
                                        <include>BaseObjectCodeWriter.java</include>
                                    </includes>
                                </resource>
                                <!-- "html-docs", "ai-docs" and "json-schema": each a generator and
                                     the writer that emits its file. -->
                                <resource>
                                    <directory>src/main/java/com/metaobjects/generator/direct/metadata/html</directory>
                                    <includes>
                                        <include>MetaDataHtmlDocumentationGenerator.java</include>
                                        <include>MetaDataHtmlDocumentationWriter.java</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <directory>src/main/java/com/metaobjects/generator/direct/metadata/ai</directory>
                                    <includes>
                                        <include>MetaDataAIDocumentationGenerator.java</include>
                                        <include>MetaDataAIDocumentationWriter.java</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <directory>src/main/java/com/metaobjects/generator/direct/metadata/file/json</directory>
                                    <includes>
                                        <include>MetaDataFileJsonSchemaGenerator.java</include>
                                        <include>MetaDataFileSchemaWriter.java</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>
</project>