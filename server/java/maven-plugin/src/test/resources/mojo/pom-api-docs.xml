<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <dependencies>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <directory>target/api-docs-test</directory>
        <plugins>
            <plugin>
                <groupId>com.metaobjects</groupId>
                <artifactId>metaobjects-maven-plugin</artifactId>
                <configuration>
                    <!-- #96: the shared fixture carries a custom @simple::fruitbasket::isKey
                         attribute (declared by no registered provider); this docs test is
                         provenance-agnostic, so it loads with the meta.lax opt-out. -->
                    <lax>true</lax>
                    <loader>
                        <classname>com.metaobjects.loader.MetaDataLoader</classname>
                        <name>api-docs-test-pom</name>
                        <sourceDir>./src/test/resources</sourceDir>
                        <sources>
                            <source>mojo/mojo-test-metadata.json</source>
                        </sources>
                    </loader>
                    <!-- The api reference is a <generator> entry like any other (ADR-0034
                         Amendment 9): one per language, each with its options in <args>. The Java
                         entry sets every option; the Kotlin entry takes every default. -->
                    <generators>
                        <generator>
                            <classname>com.metaobjects.generator.apidocs.JavaApiDocsGenerator</classname>
                            <args>
                                <outputDir>target/api-docs-test/docs</outputDir>
                                <apiSubDir>reference/java</apiSubDir>
                                <layout>package</layout>
                                <projectName>fruit-shop</projectName>
                                <modelBaseUrl>https://docs.example.test/model</modelBaseUrl>
                            </args>
                        </generator>
                        <generator>
                            <classname>com.metaobjects.generator.kotlin.apidocs.KotlinApiDocsGenerator</classname>
                            <args>
                                <outputDir>target/api-docs-test/docs</outputDir>
                            </args>
                        </generator>
                    </generators>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
