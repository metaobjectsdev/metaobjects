<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>MetaObjects.Codegen</RootNamespace>
    <PackageId>MetaObjects.Codegen</PackageId>
    <Title>MetaObjects.Codegen</Title>
    <Description>MetaObjects code generation for .NET — emits idiomatic EF Core entities, an AppDbContext, and ASP.NET Core CRUD minimal-API routes from typed metadata. Carries no EF Core or ASP.NET Core dependency: the helpers generated routes call are the MetaObjects.AspNetCore package, which the app references.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../MetaObjects/MetaObjects.csproj" />
    <ProjectReference Include="../MetaObjects.Render/MetaObjects.Render.csproj" />
  </ItemGroup>
  <!--
    ADR-0034 Amendment 3 — eject: each EJECTABLE generator's own .cs source is embedded
    as an assembly resource (AOT-safe: Assembly.GetManifestResourceStream, no filesystem
    scan of the installed tool), the same pattern MetaObjects/MetaObjects.csproj already
    uses for spec/metamodel/*.json. `dotnet meta eject <name>` reads these — never the
    file on disk — to write codegen/generators/<file> in the adopter's repo. A byte-
    identity gate test (MetaObjects.Codegen.Tests/EjectableGeneratorsEmbedTests) asserts
    each embedded copy equals its Generators/<file> source, so they cannot drift; a set-
    equality test asserts this list matches GeneratorRegistry's SourceFileName entries.
    The default MSBuild logical resource name (RootNamespace + folder + file, dots for
    separators — RootNamespace is `MetaObjects.Codegen` here) makes each one
    `MetaObjects.Codegen.Generators.<file>`. The `template` primitive is deliberately NOT
    here — it has no emit logic of its own to own (see GeneratorRegistry.cs's registry
    entries: every OTHER Native entry sets SourceFileName; `template` does not).
    ADD A NEW EJECTABLE GENERATOR: add its Include line here AND its SourceFileName in
    GeneratorRegistry.cs — the embed-set-equality test fails until both are done.

    The EMITTERS an ejectable generator calls are embedded the same way, in the same group,
    and listed on its registry entry as `Companions`: eject hands them over with the
    generator, so an owned copy owns the code that writes its output and not a shell around
    it. The embedded set is exactly the registry's SourceFileName and Companions files.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Generators/EntityGenerator.cs" />
    <EmbeddedResource Include="Generators/DbContextGenerator.cs" />
    <EmbeddedResource Include="Generators/ExpressionIndexesGenerator.cs" />
    <EmbeddedResource Include="Generators/RoutesGenerator.cs" />
    <EmbeddedResource Include="Generators/OutputParserGenerator.cs" />
    <EmbeddedResource Include="Generators/ExtractorGenerator.cs" />
    <EmbeddedResource Include="Generators/OutputPromptGenerator.cs" />
    <EmbeddedResource Include="Generators/RenderHelperGenerator.cs" />
    <EmbeddedResource Include="Generators/FilterAllowlistGenerator.cs" />
    <EmbeddedResource Include="Generators/NamesGenerator.cs" />
    <EmbeddedResource Include="Generators/RulesNamesGenerator.cs" />
    <EmbeddedResource Include="Generators/ContractTypesGenerator.cs" />
    <EmbeddedResource Include="Generators/CallableGenerator.cs" />
    <EmbeddedResource Include="Generators/RequirementTestsGenerator.cs" />
    <EmbeddedResource Include="Generators/SharedModelGenerator.cs" />
    <EmbeddedResource Include="Generators/ReportExportGenerator.cs" />
    <EmbeddedResource Include="Generators/ApiDocsGenerator.cs" />
    <!-- Emitters handed over with the generators above (their `Companions`). -->
    <EmbeddedResource Include="Generators/ExtractDelegateEmitter.cs" />
    <EmbeddedResource Include="Generators/Fr010FieldMapping.cs" />
    <EmbeddedResource Include="Generators/ContractMembers.cs" />
    <EmbeddedResource Include="Generators/Fr019SharedEnum.cs" />
    <EmbeddedResource Include="Generators/M2MNavigation.cs" />
    <EmbeddedResource Include="Generators/OutputFormatSpecEmitter.cs" />
    <EmbeddedResource Include="Generators/ReverseFinders.cs" />
    <EmbeddedResource Include="Docs/XmlDocBuilder.cs" />
    <EmbeddedResource Include="ApiDocs/CSharpApiModel.cs" />
    <EmbeddedResource Include="ApiDocs/CSharpApiModelBuilder.cs" />
    <EmbeddedResource Include="ApiDocs/CSharpApiDocsRenderer.cs" />
    <EmbeddedResource Include="ApiDocs/DocsPaths.cs" />
  </ItemGroup>
  <!--
    The HELPER RUNTIME (HelperRuntime.cs): the MetaObjects.AspNetCore files generated routes import.
    This package does not compile them (the app references MetaObjects.AspNetCore for that); it
    embeds their SOURCE so `dotnet meta eject routes` can copy it into the adopter's codegen/runtime/
    without the tool carrying ASP.NET Core or EF Core. HelperRuntimeTests asserts each embedded copy
    equals its source and that this list matches HelperRuntime.Files. Runtime/ExtractObject.cs and
    Runtime/M2MResolver.cs are core, compiled here, and deliberately NOT in this list.
  -->
  <ItemGroup>
    <EmbeddedResource Include="../MetaObjects.AspNetCore/FilterParser.cs" LogicalName="MetaObjects.AspNetCore.FilterParser.cs" Visible="false" />
    <EmbeddedResource Include="../MetaObjects.AspNetCore/FilterParseResult.cs" LogicalName="MetaObjects.AspNetCore.FilterParseResult.cs" Visible="false" />
    <EmbeddedResource Include="../MetaObjects.AspNetCore/FilterPredicate.cs" LogicalName="MetaObjects.AspNetCore.FilterPredicate.cs" Visible="false" />
    <EmbeddedResource Include="../MetaObjects.AspNetCore/FilterRules.cs" LogicalName="MetaObjects.AspNetCore.FilterRules.cs" Visible="false" />
    <EmbeddedResource Include="../MetaObjects.AspNetCore/FilterValueFormat.cs" LogicalName="MetaObjects.AspNetCore.FilterValueFormat.cs" Visible="false" />
    <EmbeddedResource Include="../MetaObjects.AspNetCore/ListQuery.cs" LogicalName="MetaObjects.AspNetCore.ListQuery.cs" Visible="false" />
    <EmbeddedResource Include="../MetaObjects.AspNetCore/EfCoreFilterDispatch.cs" LogicalName="MetaObjects.AspNetCore.EfCoreFilterDispatch.cs" Visible="false" />
    <EmbeddedResource Include="../MetaObjects.AspNetCore/ValueObjectValidator.cs" LogicalName="MetaObjects.AspNetCore.ValueObjectValidator.cs" Visible="false" />
    <EmbeddedResource Include="../MetaObjects.AspNetCore/ConstraintErrors.cs" LogicalName="MetaObjects.AspNetCore.ConstraintErrors.cs" Visible="false" />
    <EmbeddedResource Include="../MetaObjects.AspNetCore/ValidationIssues.cs" LogicalName="MetaObjects.AspNetCore.ValidationIssues.cs" Visible="false" />
    <EmbeddedResource Include="../MetaObjects.AspNetCore/UnknownFieldCheck.cs" LogicalName="MetaObjects.AspNetCore.UnknownFieldCheck.cs" Visible="false" />
    <EmbeddedResource Include="../MetaObjects.AspNetCore/Iso8601TimestampConverter.cs" LogicalName="MetaObjects.AspNetCore.Iso8601TimestampConverter.cs" Visible="false" />
    <EmbeddedResource Include="../MetaObjects.AspNetCore/DecimalWire.cs" LogicalName="MetaObjects.AspNetCore.DecimalWire.cs" Visible="false" />
    <EmbeddedResource Include="../MetaObjects.AspNetCore/DurationWire.cs" LogicalName="MetaObjects.AspNetCore.DurationWire.cs" Visible="false" />
    <EmbeddedResource Include="../MetaObjects.AspNetCore/DecimalRangeEndpointFilter.cs" LogicalName="MetaObjects.AspNetCore.DecimalRangeEndpointFilter.cs" Visible="false" />
    <EmbeddedResource Include="../MetaObjects.AspNetCore/ReportExportHttp.cs" LogicalName="MetaObjects.AspNetCore.ReportExportHttp.cs" Visible="false" />
    <EmbeddedResource Include="../MetaObjects.AspNetCore/SerializerKeys.cs" LogicalName="MetaObjects.AspNetCore.SerializerKeys.cs" Visible="false" />
  </ItemGroup>
</Project>
