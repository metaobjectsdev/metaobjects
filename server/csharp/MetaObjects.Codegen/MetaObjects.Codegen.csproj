<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>MetaObjects.Codegen</RootNamespace>
    <PackageId>MetaObjects.Codegen</PackageId>
    <Title>MetaObjects.Codegen</Title>
    <Description>MetaObjects code generation for .NET — emits idiomatic EF Core entities, an AppDbContext, and ASP.NET Core CRUD minimal-API routes from typed metadata. Includes the runtime filter/dispatch helpers that generated code references (ASP.NET Core + EF Core).</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../MetaObjects/MetaObjects.csproj" />
    <ProjectReference Include="../MetaObjects.Render/MetaObjects.Render.csproj" />
  </ItemGroup>
  <!-- Runtime helpers under Runtime/ are referenced by generated consumer code:
       FilterParser uses IQueryCollection (ASP.NET), EfCoreFilterDispatch uses
       IQueryable<T> + EF.Property<>. Consumers reference this assembly at
       runtime in their ASP.NET Core host. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.10" />
  </ItemGroup>
</Project>
