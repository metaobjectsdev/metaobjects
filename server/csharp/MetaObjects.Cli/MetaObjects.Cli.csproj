<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>MetaObjects.Cli</RootNamespace>
    <!-- Packaged as a .NET tool invoked as `dotnet meta` (command `dotnet-meta`),
         deliberately NOT a bare `meta` executable — that name belongs to the
         canonical Node `meta` CLI which owns schema + TS codegen (ADR-0015). -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-meta</ToolCommandName>
    <PackageId>MetaObjects.Cli</PackageId>
    <Title>MetaObjects CLI (dotnet meta)</Title>
    <Description>The MetaObjects .NET command-line tool, installed as `dotnet meta`. Runs C# code generation (`gen`), codegen-drift verification (`verify`), and agent-context docs (`agent-docs`) from typed metadata. Schema migrations are owned by the Node `meta` CLI (ADR-0015).</Description>
    <PackageTags>metaobjects;dotnet-tool;codegen;cli;metadata</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../MetaObjects/MetaObjects.csproj" />
    <ProjectReference Include="../MetaObjects.Render/MetaObjects.Render.csproj" />
    <ProjectReference Include="../MetaObjects.Codegen/MetaObjects.Codegen.csproj" />
  </ItemGroup>

  <!-- The test project drives the internal command entry points (e.g. AgentDocsCommand). -->
  <ItemGroup>
    <InternalsVisibleTo Include="MetaObjects.Cli.Tests" />
  </ItemGroup>

</Project>
