<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>MetaObjects.Cli</RootNamespace>
    <!-- Packaged as a .NET tool invoked as `dotnet meta` (command `dotnet-meta`),
         deliberately NOT a bare `meta` executable — that name belongs to the
         canonical Node `meta` CLI which owns schema + TS codegen (ADR-0015). -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-meta</ToolCommandName>
    <PackageId>MetaObjects.Cli</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../MetaObjects/MetaObjects.csproj" />
    <ProjectReference Include="../MetaObjects.Render/MetaObjects.Render.csproj" />
    <ProjectReference Include="../MetaObjects.Codegen/MetaObjects.Codegen.csproj" />
  </ItemGroup>

  <!-- The test project drives the internal command entry points (e.g. AgentDocsCommand). -->
  <ItemGroup>
    <InternalsVisibleTo Include="MetaObjects.Cli.Tests" />
  </ItemGroup>

  <!-- Bundle the repo-root agent-context/ content tree so `dotnet meta agent-docs`
       resolves it both in dev (run-from-output) and when installed as a .NET tool.
       Copied under <output>/agent-context/, where ContentRoot.Resolve looks first. -->
  <ItemGroup>
    <Content Include="../../../agent-context/**/*">
      <Link>agent-context/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>tools/net8.0/any/agent-context/%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
    </Content>
  </ItemGroup>
</Project>
