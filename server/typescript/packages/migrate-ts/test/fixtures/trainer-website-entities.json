{
  "metadata.root": {
    "children": [
      {
        "object.entity": {
          "name": "Subscriber",
          "children": [
            { "source.rdb": {} },
            { "field.long": { "name": "id" } },
            { "field.string": { "name": "email", "@required": true } },
            { "field.string": { "name": "firstName", "@required": true } },
            { "field.string": { "name": "source", "@default": "landing_page" } },
            { "field.boolean": { "name": "subscribed", "@required": true, "@default": "true" } },
            { "field.timestamp": { "name": "createdAt", "@required": true, "@default": "CURRENT_TIMESTAMP" } },
            { "field.timestamp": { "name": "updatedAt", "@required": true, "@default": "CURRENT_TIMESTAMP" } },
            { "identity.primary": { "name": "pk", "@fields": ["id"], "@generation": "increment" } },
            { "identity.secondary": { "name": "uniqueEmail", "@fields": ["email"] } }
          ]
        }
      },
      {
        "object.entity": {
          "name": "Program",
          "children": [
            { "source.rdb": {} },
            { "field.long": { "name": "id" } },
            { "field.string": { "name": "slug", "@required": true } },
            { "field.string": { "name": "title", "@required": true } },
            { "field.string": { "name": "description" } },
            { "field.int": { "name": "priceCents", "@required": true } },
            { "field.boolean": { "name": "isPublished", "@required": true, "@default": "false" } },
            { "field.timestamp": { "name": "createdAt", "@required": true, "@default": "CURRENT_TIMESTAMP" } },
            { "identity.primary": { "name": "pk", "@fields": ["id"], "@generation": "increment" } },
            { "identity.secondary": { "name": "uniqueSlug", "@fields": ["slug"] } }
          ]
        }
      },
      {
        "object.entity": {
          "name": "Week",
          "children": [
            { "source.rdb": {} },
            { "field.long": { "name": "id" } },
            { "field.long": { "name": "programId", "@required": true } },
            { "field.int": { "name": "weekNumber", "@required": true } },
            { "field.string": { "name": "title" } },
            { "identity.primary":   { "name": "pk", "@fields": ["id"], "@generation": "increment" } },
            { "identity.reference": { "name": "ref_program", "@fields": ["programId"], "@references": "Program" } },
            { "relationship.association": { "name": "program", "@cardinality": "one", "@objectRef": "Program" } }
          ]
        }
      },
      {
        "object.entity": {
          "name": "Workout",
          "children": [
            { "source.rdb": {} },
            { "field.long": { "name": "id" } },
            { "field.long": { "name": "weekId", "@required": true } },
            { "field.int": { "name": "dayNumber", "@required": true } },
            { "field.string": { "name": "title", "@required": true } },
            { "identity.primary":   { "name": "pk", "@fields": ["id"], "@generation": "increment" } },
            { "identity.reference": { "name": "ref_week", "@fields": ["weekId"], "@references": "Week" } },
            { "relationship.association": { "name": "week", "@cardinality": "one", "@objectRef": "Week" } }
          ]
        }
      },
      {
        "object.entity": {
          "name": "Video",
          "children": [
            { "source.rdb": {} },
            { "field.long": { "name": "id" } },
            { "field.string": { "name": "bunnyVideoId", "@required": true } },
            { "field.string": { "name": "title", "@required": true } },
            { "field.int": { "name": "durationSeconds" } },
            { "field.timestamp": { "name": "createdAt", "@required": true, "@default": "CURRENT_TIMESTAMP" } },
            { "field.uuid": { "name": "thumbnailAssetId" } },
            { "identity.primary": { "name": "pk", "@fields": ["id"], "@generation": "increment" } },
            { "identity.reference": {
                "name": "ref_thumbnail",
                "@fields": ["thumbnailAssetId"],
                "@references": "MediaAsset",
                "@constraintName": "fk_video_thumbnail_asset"
            } },
            { "relationship.association": { "name": "thumbnail", "@cardinality": "one", "@objectRef": "MediaAsset" } }
          ]
        }
      },
      {
        "object.entity": {
          "name": "MediaAsset",
          "children": [
            { "source.rdb": {} },
            { "field.uuid": { "name": "id" } },
            { "field.string": { "name": "storageKey", "@required": true } },
            { "field.string": { "name": "caption", "@default": "n/a (unknown)" } },
            { "field.string": { "name": "altText", "@default": "don't know" } },
            { "field.boolean": { "name": "archived", "@required": true, "@default": "false" } },
            { "field.decimal": { "name": "fileSizeMb", "@precision": 12, "@scale": 3 } },
            { "field.enum": { "name": "kind", "@required": true, "@values": ["IMAGE", "VIDEO", "AUDIO"] } },
            { "field.timestamp": { "name": "createdAt", "@required": true, "@autoSet": "onCreate" } },
            { "identity.primary": { "name": "pk", "@fields": ["id"], "@generation": "uuid" } },
            { "identity.secondary": {
                "name": "uniqueStorageKey",
                "@fields": ["storageKey"],
                "@where": "caption IS NOT NULL"
            } },
            { "index.lookup": { "name": "byCaptionLower", "@fields": ["caption"], "@expr": "lower(caption)" } },
            { "index.lookup": { "name": "byCreated", "@fields": ["createdAt"], "@orders": ["desc"] } }
          ]
        }
      },
      {
        "object.entity": {
          "name": "Exercise",
          "children": [
            { "source.rdb": {} },
            { "field.long": { "name": "id" } },
            { "field.long": { "name": "workoutId", "@required": true } },
            { "field.long": { "name": "videoId" } },
            { "field.int": { "name": "sortOrder", "@required": true, "@default": "0" } },
            { "field.string": { "name": "name", "@required": true } },
            { "identity.primary":   { "name": "pk", "@fields": ["id"], "@generation": "increment" } },
            { "identity.reference": { "name": "ref_workout", "@fields": ["workoutId"], "@references": "Workout" } },
            { "identity.reference": { "name": "ref_video", "@fields": ["videoId"], "@references": "Video" } },
            { "relationship.association": { "name": "workout", "@cardinality": "one", "@objectRef": "Workout" } },
            { "relationship.association": { "name": "video", "@cardinality": "one", "@objectRef": "Video" } }
          ]
        }
      }
    ]
  }
}
