{
  "name": "@metaobjects/cli",
  "version": "0.2.0",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./src/index.ts",
  "bin": {
    "meta": "./bin/meta.ts"
  },
  "publishConfig": {
    "bin": {
      "meta": "./dist/bin/meta.js"
    }
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@metaobjects/sdk": "workspace:*",
    "@metaobjects/metadata": "workspace:*",
    "@metaobjects/codegen-ts": "workspace:*",
    "@metaobjects/codegen-ts-tanstack": "workspace:*",
    "@metaobjects/migrate-ts": "workspace:*",
    "@metaobjects/forge": "workspace:*",
    "jiti": "^2.4.0"
  },
  "peerDependencies": {
    "kysely": ">=0.27.0",
    "pg": ">=8.0.0",
    "@libsql/kysely-libsql": ">=0.4.0"
  },
  "peerDependenciesMeta": {
    "pg": { "optional": true },
    "@libsql/kysely-libsql": { "optional": true }
  },
  "devDependencies": {
    "bun-types": "latest",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "@libsql/kysely-libsql": "^0.4.1",
    "@libsql/client": "^0.14.0",
    "kysely": "^0.27.0",
    "pg": "^8.0.0",
    "@types/pg": "^8.0.0",
    "pg-mem": "^3.0.4"
  }
}
