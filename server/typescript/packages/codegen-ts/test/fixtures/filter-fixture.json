{
  "metadata.root": {
    "children": [
      {
        "object.entity": {
          "name": "Subscriber",
          "children": [
            { "source.rdb": { "@table": "subscribers" } },
            { "field.long": { "name": "id" } },
            { "field.string": { "name": "email", "@filterable": true } },
            { "field.string": { "name": "firstName", "@filterable": true } },
            { "field.string": { "name": "lastName", "@filterable": true, "@sortable": false } },
            { "field.boolean": { "name": "subscribed", "@filterable": true } },
            {
              "field.timestamp": {
                "name": "createdAt",
                "@filterable": true,
                "@sortable": true,
                "@sortableDefaultOrder": "desc"
              }
            },
            { "field.string": { "name": "internalNote" } },
            { "identity.primary": { "name": "id", "@fields": "id" } }
          ]
        }
      },
      {
        "object.entity": {
          "name": "Product",
          "children": [
            { "source.rdb": { "@table": "products" } },
            { "field.long": { "name": "id" } },
            { "field.string": { "name": "title" } },
            { "field.decimal": { "name": "price", "@sortable": true } },
            { "identity.primary": { "name": "id", "@fields": "id" } }
          ]
        }
      },
      {
        "object.entity": {
          "name": "Book",
          "children": [
            { "source.rdb": { "@table": "books" } },
            { "field.long": { "name": "id" } },
            { "field.date": { "name": "publishedOn", "@filterable": true } },
            { "field.time": { "name": "opensAt", "@filterable": true } },
            { "field.timestamp": { "name": "updatedAt", "@filterable": true } },
            { "field.uuid": { "name": "externalId", "@filterable": true } },
            { "field.enum": { "name": "genre", "@filterable": true, "@values": ["fiction", "poetry"] } },
            {
              "field.enum": {
                "name": "priority",
                "@filterable": true,
                "@values": ["low", "high"],
                "@intValueMap": { "low": 1, "high": 2 }
              }
            },
            { "field.string": { "name": "title", "@filterable": true } },
            { "identity.primary": { "name": "id", "@fields": "id" } }
          ]
        }
      }
    ]
  }
}
