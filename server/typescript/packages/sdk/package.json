{
  "name": "@metaobjectsdev/sdk",
  "version": "0.15.2",
  "description": "Workspace helpers and agent-docs utilities for MetaObjects projects.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./agent-docs": {
      "bun": "./src/agent-docs/index.ts",
      "types": "./dist/agent-docs/index.d.ts",
      "default": "./dist/agent-docs/index.js"
    },
    "./agent-context": {
      "bun": "./src/agent-context/index.ts",
      "types": "./dist/agent-context/index.d.ts",
      "default": "./dist/agent-context/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "agent-context",
    "scripts"
  ],
  "scripts": {
    "bundle-agent-context": "node scripts/bundle-agent-context.mjs",
    "build": "node scripts/bundle-agent-context.mjs && tsc -p .",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "license": "Apache-2.0",
  "author": "Doug Mealing <doug@dougmealing.com>",
  "homepage": "https://metaobjects.dev",
  "bugs": {
    "url": "https://github.com/metaobjectsdev/metaobjects/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/metaobjectsdev/metaobjects.git",
    "directory": "server/typescript/packages/sdk"
  },
  "keywords": [
    "metaobjects",
    "sdk",
    "agent-docs",
    "workspace"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@metaobjectsdev/metadata": "workspace:*",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "bun-types": "latest",
    "typescript": "^5.6.0"
  }
}
