{
  "name": "@metaobjects/forge",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./agent-docs": {
      "bun": "./src/agent-docs/index.ts",
      "types": "./src/agent-docs/index.ts",
      "default": "./dist/agent-docs/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "devDependencies": {
    "bun-types": "latest",
    "typescript": "^5.6.0"
  },
  "description": "AI-collaboration capabilities for the MetaObjects standard"
}
