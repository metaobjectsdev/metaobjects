              "field.boolean": {
                "name": "premiumLocation",
                "@default": false
              }
            }
          ]
        }
      },
      {
        "object.entity": {
          "name": "Vehicle",
          "package": "::vehicle",
          "overlay": true,
          "children": [
            {
              "field.boolean": {
                "name": "warranty",
                "@default": true
              }
            },
            {
              "field.date": {
                "name": "inspectionDate",
                "children": [
                  {
                    "validator.required": {
                      "name": "pastDate",
                      "@maxDate": "today"
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "object.entity": {
          "name": "Porsche",
          "package": "::vehicle::car::luxury",
          "overlay": true,
          "children": [
            {
              "field.boolean": {
                "name": "certifiedPreOwned",
                "@default": false
              }
            }
          ]
        }
      },
      {
        "object.entity": {
          "name": "Motorcycle",
          "package": "::vehicle::motorcycle",
          "overlay": true,
          "children": [
            {
              "field.boolean": {
                "name": "customPaint",
                "@default": false
              }
            }
          ]
        }
      }
    ]
  }
}
