{
  "$schema": "simple-model.schema.json",
  "metadata.root": {
    "package": "simple::fruitbasket",
    "children": [
      {
        "field.long": {
          "name": "id",
          "package": "simple::common",
          "abstract": true,
          "children": [
            {
              "attr.boolean": {
                "name": "isKey",
                "value": true
              }
            }
          ]
        }
      },
      {
        "field.string": {
          "name": "name",
          "package": "simple::common",
          "abstract": true,
          "children": [
            {
              "validator.required": {}
            },
            {
              "validator.length": {
                "@min": 1,
                "@max": 50
              }
            }
          ]
        }
      },
      {
        "object.entity": {
          "name": "Basket",
          "@object": "com.metaobjects.loader.simple.fruitbasket.Basket",
          "children": [
            {
              "field.base": {
                "name": "id",
                "extends": "..::common::id"
              }
            },
            {
              "field.base": {
                "name": "name",
                "extends": "..::common::name"
              }
            },
            {
              "field.int": {
                "name": "numApples",
                "children": [
                  {
                    "validator.length": {
                      "@min": 0,
                      "@max": 10
                    }
                  }
                ]
              }
            },
            {
              "field.int": {
                "name": "numOranges",
                "children": [
                  {
                    "validator.length": {
                      "@min": 0,
                      "@max": 10
                    }
                  }
                ]
              }
            },
            {
              "field.object": {
                "name": "apples",
                "isArray": true,
                "@objectRef": "::Apple"
              }
            },
            {
              "field.object": {
                "name": "oranges",
                "isArray": true,
                "@objectRef": "::Orange"
              }
            }
          ]
        }
      },
      {
        "object.entity": {
          "name": "Fruit",
          "abstract": true,
          "@object": "com.metaobjects.loader.simple.fruitbasket.Fruit",
          "children": [
            {
              "field.base": {
                "name": "id",
                "extends": "..::common::id"
              }
            },
            {
              "field.base": {
                "name": "name",
                "extends": "..::common::name"
              }
            },
            {
              "field.int": {
                "name": "length"
              }
            },
            {
              "field.int": {
                "name": "weight"
              }
            },
            {
              "field.boolean": {
                "name": "inBasket"
              }
            }
          ]
        }
      },
      {
        "object.base": {
          "name": "Apple",
          "extends": "Fruit",
          "@object": "com.metaobjects.loader.simple.fruitbasket.Apple",
          "children": [
            {
              "field.string": {
                "name": "orchard"
              }
            },
            {
              "field.int": {
                "name": "worms"
              }
            }
          ]
        }
      },
      {
        "object.base": {
          "name": "Macintosh",
          "extends": "Apple",
          "@object": "com.metaobjects.loader.simple.fruitbasket.Macintosh"
        }
      },
      {
        "object.base": {
          "name": "Orange",
          "extends": "Fruit",
          "@object": "com.metaobjects.loader.simple.fruitbasket.Orange",
          "children": [
            {
              "field.date": {
                "name": "pickedDate"
              }
            }
          ]
        }
      }
    ]
  }
}
