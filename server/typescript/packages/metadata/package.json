{
  "name": "@metaobjectsdev/metadata",
  "version": "0.24.4",
  "description": "Metamodel loader, types, and constants for the MetaObjects standard.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "bun": "./src/core/index.ts",
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./library": {
      "bun": "./src/library/library-sources.ts",
      "types": "./dist/library/library-sources.d.ts",
      "default": "./dist/library/library-sources.js"
    },
    "./constants": {
      "bun": "./src/constants.ts",
      "types": "./dist/constants.d.ts",
      "default": "./dist/constants.js"
    },
    "./vocabulary-rewrite-yaml": {
      "bun": "./src/core/vocabulary-rewrite-yaml.ts",
      "types": "./dist/core/vocabulary-rewrite-yaml.d.ts",
      "default": "./dist/core/vocabulary-rewrite-yaml.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "conformance:mutation": "stryker run"
  },
  "license": "Apache-2.0",
  "author": "Doug Mealing <doug@dougmealing.com>",
  "homepage": "https://metaobjects.dev",
  "bugs": {
    "url": "https://github.com/metaobjectsdev/metaobjects/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/metaobjectsdev/metaobjects.git",
    "directory": "server/typescript/packages/metadata"
  },
  "keywords": [
    "metaobjects",
    "metadata",
    "schema",
    "loader",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@metaobjectsdev/conformance": "workspace:*",
    "@stryker-mutator/core": "^9.6.1",
    "bun-types": "latest",
    "typescript": "^5.6.0"
  }
}
