{
  "name": "@metaobjects/runtime-ts-client",
  "version": "0.1.0",
  "description": "Browser-safe runtime for metaobjects entities — currency, TanStack hooks, cell renderers, CurrencyInput",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "bun": "./src/react/index.tsx",
      "types": "./src/react/index.tsx",
      "default": "./dist/react/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@metaobjects/metadata": "workspace:*",
    "qs": "^6.13.0"
  },
  "peerDependencies": {
    "@hookform/resolvers": ">=3.0.0",
    "@tanstack/react-query": ">=5.90.0",
    "@tanstack/react-table": ">=8.20.0",
    "react": ">=18.0.0",
    "react-hook-form": ">=7.0.0",
    "zod": ">=3.23.0"
  },
  "peerDependenciesMeta": {
    "@hookform/resolvers": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "@tanstack/react-table": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-table": "^8.20.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/dom": "^10.0.0",
    "@types/react": "^19.0.0",
    "@types/qs": "^6.9.0",
    "bun-types": "latest",
    "jsdom": "^29.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "typescript": "^5.6.0",
    "zod": "^4.4.3"
  }
}
