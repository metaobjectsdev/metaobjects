{
  "name": "@metaobjects/runtime-ts",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./drivers": {
      "bun": "./src/drivers/index.ts",
      "types": "./src/drivers/index.ts",
      "default": "./dist/drivers/index.js"
    },
    "./fastify": {
      "bun": "./src/fastify/index.ts",
      "types": "./src/fastify/index.ts",
      "default": "./dist/fastify/index.js"
    },
    "./drizzle-fastify": {
      "bun": "./src/drizzle-fastify/index.ts",
      "types": "./src/drizzle-fastify/index.ts",
      "default": "./dist/drizzle-fastify/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@metaobjects/metadata": "workspace:*",
    "qs": "^6.13.0"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.36.0",
    "fastify": ">=5.0.0",
    "kysely": ">=0.27.0",
    "zod": ">=3.23.0"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "kysely": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@libsql/client": "^0.15.0",
    "@libsql/kysely-libsql": "^0.4.1",
    "@types/qs": "^6.9.0",
    "bun-types": "latest",
    "drizzle-orm": "^0.45.1",
    "fastify": "^5.6.2",
    "jsdom": "^29.1.1",
    "kysely": "^0.27.0",
    "pg-mem": "^3.0.4",
    "typescript": "^5.6.0",
    "zod": "^4.4.3"
  }
}
