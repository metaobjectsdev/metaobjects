{
  "name": "@metaobjects/metadata",
  "version": "0.2.4",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "bun": "./src/core/index.ts",
      "types": "./src/core/index.ts",
      "default": "./dist/core/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@metaobjects/conformance": "workspace:*",
    "bun-types": "latest",
    "typescript": "^5.6.0"
  }
}
