{
  "metadata.root": {
    "children": [
      {
        "object.entity": {
          "name": "User",
          "children": [
            { "field.long": { "name": "id" } },
            { "field.string": { "name": "email", "@required": true } },
            { "field.string": { "name": "firstName" } },
            { "field.boolean": { "name": "isActive", "@default": "true" } },
            { "field.timestamp": { "name": "createdAt", "@default": "CURRENT_TIMESTAMP", "@required": true } },
            { "identity.primary": { "name": "pk", "@fields": ["id"], "@generation": "increment" } }
          ]
        }
      }
    ]
  }
}
