{
  "name": "@metaobjectsdev/monorepo",
  "version": "0.5.0",
  "private": true,
  "description": "MetaObjects — cross-language metadata standard. Repo-root JS/TS workspace.",
  "type": "module",
  "workspaces": [
    "server/typescript/packages/*",
    "client/web/packages/*",
    "examples/dynamic-grid",
    "packs/*/typescript"
  ],
  "scripts": {
    "build": "bun run --filter './server/typescript/packages/*' --filter './client/web/packages/*' --filter './examples/dynamic-grid' build",
    "typecheck": "bun run --filter './server/typescript/packages/*' --filter './client/web/packages/*' --filter './examples/dynamic-grid' typecheck",
    "test": "cd server/typescript && bun test",
    "regen:showcase": "bun scripts/regen-showcase.ts",
    "site:payload": "bun scripts/build-site-payload.ts",
    "site:reference": "bun scripts/build-site-reference.ts",
    "site:preview": "bun scripts/site-preview.ts",
    "clean": "rm -rf server/typescript/packages/*/dist server/typescript/packages/*/*.tsbuildinfo client/web/packages/*/dist client/web/packages/*/*.tsbuildinfo",
    "release": "bun scripts/release.mjs",
    "prerelease:publish": "bun scripts/prerelease.mjs",
    "prerelease:candidate": "bun scripts/prerelease.mjs --only all"
  },
  "devDependencies": {
    "bun-types": "latest",
    "highlight.js": "^11.11.0",
    "marked": "^18.0.11",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22.0.0"
  },
  "packageManager": "bun@1.3.8"
}
