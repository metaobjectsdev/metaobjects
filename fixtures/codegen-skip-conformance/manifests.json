  "provenance": {
    "$comment": "Generated-file provenance (the docs view's 'files'): after a write run, each recorded path's entry names the generator that wrote it and, for a file rendered from one node, that node's resolution key. A port seeds 'beforeFiles' as its .hashes/ directory, records 'records' (with the vectors' 'objects' as the loaded model), and must then hold exactly 'afterFiles'. A record with a sourceNode makes the entry { hash, <other fields kept in order>, generatedBy, sourceNode }; one without returns the entry to the plain hash (or to { hash, <other fields> } when it has owner fields); a path with no recorded hash is left out; the sourceNode then places the entry. 'goldenText' is one file's bytes in full. Recording the same records a second time changes no file.",
    "beforeFiles": {
      "acme.shop.json": {
        "gen/Order.ts": "h1",
        "gen/OrderDto.java": {
          "hash": "h2",
          "generator": "java:dto",
          "outputDir": "gen"
        }
      },
      "acme.crm.json": {
        "gen/Customer.ts": {
          "hash": "h3",
          "generatedBy": "entity",
          "sourceNode": "acme::crm::Customer"
        }
      },
      "acme.billing.json": {
        "gen/Invoice.ts": "h5"
      },
      "gone.json": {
        "gen/index.ts": {
          "hash": "h4",
          "generatedBy": "barrel",
          "sourceNode": "gone::X"
        }
      },
      ".root.json": {
        "gen/Item.ts": "h6"
      }
    },
    "records": [
