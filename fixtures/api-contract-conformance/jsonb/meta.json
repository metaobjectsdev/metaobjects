{
  "metadata.root": {
    "package": "acme::store",
    "children": [
      { "object.value": {
        "name": "Marker",
        "children": [
          { "field.string": { "name": "label", "@required": true, "@maxLength": 40 } },
          { "field.int":    { "name": "score" } }
        ]
      }},
      { "object.value": {
        "name": "Measure",
        "children": [
          { "field.double":  { "name": "ratio" } },
          { "field.double":  { "name": "samples", "isArray": true } },
          { "field.decimal": { "name": "amount", "@precision": 12, "@scale": 4 } }
        ]
      }},
      { "object.value": {
        "name": "Tier",
        "children": [
          { "field.decimal": { "name": "amount", "@precision": 12, "@scale": 4 } }
        ]
      }},
      { "object.value": {
        "name": "Pricing",
        "children": [
          { "field.map": { "name": "tiers", "@objectRef": "Tier" } }
        ]
      }},
      { "object.entity": {
        "name": "Document",
        "children": [
          { "source.rdb":       { "@table": "documents" } },
          { "field.long":       { "name": "id", "@required": true, "@filterable": true, "@sortable": true } },
          { "field.string":     { "name": "title", "@required": true, "@maxLength": 200, "@filterable": true, "@sortable": true } },
          { "field.string":     { "name": "payload", "@dbColumnType": "jsonb" } },
          { "field.object":     { "name": "primaryMarker",  "@objectRef": "Marker", "@storage": "jsonb", "@required": true } },
          { "field.object":     { "name": "optionalMarker", "@objectRef": "Marker", "@storage": "jsonb" } },
          { "field.object":     { "name": "markers",        "@objectRef": "Marker", "@storage": "jsonb", "isArray": true } },
          { "field.object":     { "name": "measure",  "@objectRef": "Measure", "@storage": "jsonb" } },
          { "field.object":     { "name": "measures", "@objectRef": "Measure", "@storage": "jsonb", "isArray": true } },
          { "field.map":        { "name": "tiers", "@objectRef": "Tier" } },
          { "field.object":     { "name": "pricing", "@objectRef": "Pricing", "@storage": "jsonb" } },
          { "identity.primary": { "name": "id", "@fields": "id", "@generation": "increment" } }
        ]
      }}
    ]
  }
}
