{
  "metadata.root": {
    "package": "acme::secrets",
    "children": [
      { "object.entity": {
        "name": "Account",
        "children": [
          { "source.rdb":       { "@table": "accounts" } },
          { "field.long":       { "name": "id", "@filterable": true, "@sortable": true } },
          { "field.string":     { "name": "name", "@required": true, "@maxLength": 100, "@filterable": true, "@sortable": true } },
          { "field.string":     { "name": "tokenHash", "@maxLength": 100, "@formExclude": true } },
          { "field.string":     { "name": "pinHash", "@maxLength": 100, "children": [ { "view.password": {} } ] } },
          { "identity.primary": { "name": "id", "@fields": "id", "@generation": "increment" } }
        ]
      }}
    ]
  }
}
