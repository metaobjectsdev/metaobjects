{ "metadata.root": {
  "package": "acme::ledger",
  "children": [
    { "object.entity": { "name": "Entry", "children": [
        { "source.rdb":         { "@table": "entries" } },
        { "field.long":         { "name": "id", "@filterable": true, "@sortable": true } },
        { "field.string":       { "name": "bucket", "@required": true, "@maxLength": 8, "@filterable": true, "@sortable": true } },
        { "field.decimal":      { "name": "amount", "@precision": 28, "@scale": 10, "@filterable": true, "@sortable": true } },
        { "field.boolean":      { "name": "flagged", "@required": true } },
        { "identity.primary":   { "name": "pk", "@fields": "id", "@generation": "increment" } },
        { "dimension.attribute": { "name": "bucket", "@of": "Entry.bucket" } },
        { "measure.aggregate":  { "name": "entries", "@agg": "count", "@of": "Entry.id" } },
        { "measure.aggregate":  { "name": "flaggedEntries", "@agg": "count", "@of": "Entry.id", "@filter": { "flagged": true } } },
        { "measure.aggregate":  { "name": "total", "@agg": "sum", "@of": "Entry.amount" } },
        { "measure.aggregate":  { "name": "totalOrZero", "@agg": "sum", "@of": "Entry.amount", "@default": 0 } },
        { "measure.aggregate":  { "name": "mean", "@agg": "avg", "@of": "Entry.amount" } },
        { "measure.aggregate":  { "name": "top", "@agg": "max", "@of": "Entry.amount" } },
        { "measure.ratio":      { "name": "flaggedShare", "@numerator": "flaggedEntries", "@denominator": "entries" } },
        { "measure.ratio":      { "name": "perFlagged", "@numerator": "entries", "@denominator": "flaggedEntries" } }
    ] } },
    { "object.entity": { "name": "Sample", "children": [
        { "source.rdb":         { "@table": "samples" } },
        { "field.long":         { "name": "id", "@filterable": true, "@sortable": true } },
        { "field.decimal":      { "name": "readings", "isArray": true, "@precision": 9, "@scale": 4 } },
        { "field.decimal":      { "name": "free" } },
        { "identity.primary":   { "name": "pk", "@fields": "id", "@generation": "increment" } }
    ] } },
    { "object.report": { "name": "EntryTotals", "@from": "Entry", "@dimensions": ["bucket"],
      "@measures": ["entries", "total", "totalOrZero", "mean", "top", "flaggedShare", "perFlagged"],
      "children": [ { "source.rdb": { "@kind": "view", "@view": "v_entry_totals" } } ] } }
  ]
} }
