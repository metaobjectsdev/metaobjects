{
  "cases": [
    {
      "name": "valid-baseline",
      "payload": { "name": "Acme", "code": "ABC", "score": 50, "tags": ["x"], "note": "ok" },
      "expectValid": true
    },
    {
      "name": "name-missing",
      "payload": { "code": "ABC", "score": 50, "tags": ["x"], "note": "ok" },
      "expectValid": false
    },
    {
      "name": "name-too-long",
      "payload": { "name": "AcmeAccount1", "code": "ABC", "score": 50, "tags": ["x"], "note": "ok" },
      "expectValid": false
    },
    {
      "name": "code-too-short",
      "payload": { "name": "Acme", "code": "AB", "score": 50, "tags": ["x"], "note": "ok" },
      "expectValid": false
    },
    {
      "name": "code-pattern-mismatch",
      "payload": { "name": "Acme", "code": "abc", "score": 50, "tags": ["x"], "note": "ok" },
      "expectValid": false
    },
    {
      "name": "score-below-min",
      "payload": { "name": "Acme", "code": "ABC", "score": -1, "tags": ["x"], "note": "ok" },
      "expectValid": false
    },
    {
      "name": "score-above-max",
      "payload": { "name": "Acme", "code": "ABC", "score": 101, "tags": ["x"], "note": "ok" },
      "expectValid": false
    },
    {
      "name": "tags-empty",
      "payload": { "name": "Acme", "code": "ABC", "score": 50, "tags": [], "note": "ok" },
      "expectValid": false
    },
    {
      "name": "tags-too-many",
      "payload": { "name": "Acme", "code": "ABC", "score": 50, "tags": ["a", "b", "c", "d"], "note": "ok" },
      "expectValid": false
    },
    {
      "name": "name-empty",
      "payload": { "name": "", "code": "ABC", "score": 50, "tags": ["x"], "note": "ok" },
      "expectValid": false
    },
    {
      "name": "name-whitespace",
      "payload": { "name": "   ", "code": "ABC", "score": 50, "tags": ["x"], "note": "ok" },
      "expectValid": true
    },
    {
      "name": "pattern-unanchored",
      "payload": { "name": "Acme", "code": "xxABCyy", "score": 50, "tags": ["x"], "note": "ok" },
      "expectValid": false
    },
    {
      "name": "both-length-ok",
      "payload": { "name": "Acme", "code": "ABC", "score": 50, "tags": ["x"], "label": "1234", "note": "ok" },
      "expectValid": true
    },
    {
      "name": "both-length-bounds",
      "payload": { "name": "Acme", "code": "ABC", "score": 50, "tags": ["x"], "label": "12345", "note": "ok" },
      "expectValid": false
    },
    {
      "name": "note-empty-allowed",
      "payload": { "name": "Acme", "code": "ABC", "score": 50, "tags": ["x"], "note": "" },
      "expectValid": true
    },
    {
      "name": "note-missing",
      "payload": { "name": "Acme", "code": "ABC", "score": 50, "tags": ["x"] },
      "expectValid": false
    },

    { "name": "uri-accept-https",  "payload": { "name": "Acme", "code": "ABC", "score": 50, "tags": ["x"], "note": "ok", "website": "https://a.com" },       "expectValid": true },
    { "name": "uri-accept-ftp",    "payload": { "name": "Acme", "code": "ABC", "score": 50, "tags": ["x"], "note": "ok", "website": "ftp://ftp.x.com/p" },   "expectValid": true },
    { "name": "uri-accept-mailto", "payload": { "name": "Acme", "code": "ABC", "score": 50, "tags": ["x"], "note": "ok", "website": "mailto:a@b.com" },      "expectValid": true },
    { "name": "uri-accept-urn",    "payload": { "name": "Acme", "code": "ABC", "score": 50, "tags": ["x"], "note": "ok", "website": "urn:isbn:0451450523" }, "expectValid": true },
    { "name": "uri-accept-padded", "payload": { "name": "Acme", "code": "ABC", "score": 50, "tags": ["x"], "note": "ok", "website": "  https://a.com  " },   "expectValid": true },
    { "name": "uri-reject-schemeless", "payload": { "name": "Acme", "code": "ABC", "score": 50, "tags": ["x"], "note": "ok", "website": "example.com" },     "expectValid": false },
    { "name": "uri-reject-relative",   "payload": { "name": "Acme", "code": "ABC", "score": 50, "tags": ["x"], "note": "ok", "website": "/path/only" },      "expectValid": false },
    { "name": "uri-reject-garbage",    "payload": { "name": "Acme", "code": "ABC", "score": 50, "tags": ["x"], "note": "ok", "website": "not a url" },       "expectValid": false },
    { "name": "uri-reject-empty-authority", "payload": { "name": "Acme", "code": "ABC", "score": 50, "tags": ["x"], "note": "ok", "website": "http://" },    "expectValid": false },

    { "name": "inet-accept-ipv4",      "payload": { "name": "Acme", "code": "ABC", "score": 50, "tags": ["x"], "note": "ok", "sourceIp": "192.168.0.1" },    "expectValid": true },
    { "name": "inet-accept-ipv6",      "payload": { "name": "Acme", "code": "ABC", "score": 50, "tags": ["x"], "note": "ok", "sourceIp": "::1" },            "expectValid": true },
    { "name": "inet-accept-ipv6-full", "payload": { "name": "Acme", "code": "ABC", "score": 50, "tags": ["x"], "note": "ok", "sourceIp": "2001:db8::1" },    "expectValid": true },
    { "name": "inet-reject-hostname",   "payload": { "name": "Acme", "code": "ABC", "score": 50, "tags": ["x"], "note": "ok", "sourceIp": "example.com" },   "expectValid": false },
    { "name": "inet-reject-octet-range","payload": { "name": "Acme", "code": "ABC", "score": 50, "tags": ["x"], "note": "ok", "sourceIp": "256.1.1.1" },     "expectValid": false },
    { "name": "inet-reject-cidr",       "payload": { "name": "Acme", "code": "ABC", "score": 50, "tags": ["x"], "note": "ok", "sourceIp": "192.168.0.1/24" },"expectValid": false },
    { "name": "inet-reject-padded",     "payload": { "name": "Acme", "code": "ABC", "score": 50, "tags": ["x"], "note": "ok", "sourceIp": " 192.168.0.1 " }, "expectValid": false },

    { "name": "lenient-uri-accepts-schemeless", "payload": { "name": "Acme", "code": "ABC", "score": 50, "tags": ["x"], "note": "ok", "citationUrl": "example.com" },   "expectValid": true },
    { "name": "lenient-uri-accepts-garbage",    "payload": { "name": "Acme", "code": "ABC", "score": 50, "tags": ["x"], "note": "ok", "citationUrl": "not a url" },     "expectValid": true },
    { "name": "lenient-uri-accepts-valid",      "payload": { "name": "Acme", "code": "ABC", "score": 50, "tags": ["x"], "note": "ok", "citationUrl": "https://a.com" }, "expectValid": true },
    { "name": "lenient-inet-accepts-hostname",  "payload": { "name": "Acme", "code": "ABC", "score": 50, "tags": ["x"], "note": "ok", "reportedIp": "example.com" },    "expectValid": true },
    { "name": "lenient-inet-accepts-cidr",      "payload": { "name": "Acme", "code": "ABC", "score": 50, "tags": ["x"], "note": "ok", "reportedIp": "192.168.0.1/24" },"expectValid": true },
    { "name": "lenient-inet-accepts-valid",     "payload": { "name": "Acme", "code": "ABC", "score": 50, "tags": ["x"], "note": "ok", "reportedIp": "10.0.0.1" },      "expectValid": true }
  ]
}
