{
  "cases": [
    {
      "name": "valid-baseline",
      "payload": { "name": "Acme", "code": "ABC", "score": 50, "tags": ["x"] },
      "expectValid": true
    },
    {
      "name": "name-missing",
      "payload": { "code": "ABC", "score": 50, "tags": ["x"] },
      "expectValid": false
    },
    {
      "name": "name-too-long",
      "payload": { "name": "AcmeAccount1", "code": "ABC", "score": 50, "tags": ["x"] },
      "expectValid": false
    },
    {
      "name": "code-too-short",
      "payload": { "name": "Acme", "code": "AB", "score": 50, "tags": ["x"] },
      "expectValid": false
    },
    {
      "name": "code-pattern-mismatch",
      "payload": { "name": "Acme", "code": "abc", "score": 50, "tags": ["x"] },
      "expectValid": false
    },
    {
      "name": "score-below-min",
      "payload": { "name": "Acme", "code": "ABC", "score": -1, "tags": ["x"] },
      "expectValid": false
    },
    {
      "name": "score-above-max",
      "payload": { "name": "Acme", "code": "ABC", "score": 101, "tags": ["x"] },
      "expectValid": false
    },
    {
      "name": "tags-empty",
      "payload": { "name": "Acme", "code": "ABC", "score": 50, "tags": [] },
      "expectValid": false
    },
    {
      "name": "tags-too-many",
      "payload": { "name": "Acme", "code": "ABC", "score": 50, "tags": ["a", "b", "c", "d"] },
      "expectValid": false
    },
    {
      "name": "name-empty",
      "payload": { "name": "", "code": "ABC", "score": 50, "tags": ["x"] },
      "expectValid": false
    },
    {
      "name": "name-whitespace",
      "payload": { "name": "   ", "code": "ABC", "score": 50, "tags": ["x"] },
      "expectValid": true
    },
    {
      "name": "pattern-unanchored",
      "payload": { "name": "Acme", "code": "xxABCyy", "score": 50, "tags": ["x"] },
      "expectValid": false
    },
    {
      "name": "both-length-ok",
      "payload": { "name": "Acme", "code": "ABC", "score": 50, "tags": ["x"], "label": "1234" },
      "expectValid": true
    },
    {
      "name": "both-length-bounds",
      "payload": { "name": "Acme", "code": "ABC", "score": 50, "tags": ["x"], "label": "12345" },
      "expectValid": false
    }
  ]
}
