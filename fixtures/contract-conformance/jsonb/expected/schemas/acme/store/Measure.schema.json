{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/acme/store/Measure.schema.json",
  "title": "Measure",
  "type": "object",
  "properties": {
    "ratio": {
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "samples": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "number",
        "format": "double"
      }
    },
    "amount": {
      "type": [
        "string",
        "number",
        "null"
      ],
      "description": "A decimal. Set wire.decimals to \"string\" to fix one form across server languages. Precision 12, scale 4."
    }
  }
}
