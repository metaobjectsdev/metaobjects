{
  "title": "Telemetry",
  "type": "object",
  "properties": {
    "capturedAt": {
      "description": "An instant. A value with no offset is read as UTC. Pattern: ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})?$.",
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "tempC": {
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "capturedAt",
    "latitude",
    "tempC"
  ],
  "additionalProperties": false
}
