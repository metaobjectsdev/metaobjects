            "format": "int32"
          }
        },
        "required": [
          "capturedAt",
          "latitude"
        ]
      },
      "TelemetryCreate": {
        "title": "TelemetryCreate",
        "type": "object",
        "properties": {
          "capturedAt": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})?$",
            "description": "An instant. A value with no offset is read as UTC."
          },
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "tempC": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "capturedAt",
          "latitude"
        ]
      },
      "Tier": {
        "title": "Tier",
        "type": "object",
        "properties": {
          "amount": {
            "type": [
              "string",
              "number",
              "null"
            ],
            "description": "A decimal. Set wire.decimals to \"string\" to fix one form across server languages. Precision 12, scale 4."
          }
        }
      },
      "TierCreate": {
        "title": "TierCreate",
        "type": "object",
        "properties": {
          "amount": {
            "type": [
              "string",
              "number"
            ],
            "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
