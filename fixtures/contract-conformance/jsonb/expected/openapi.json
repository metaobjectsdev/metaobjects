            }
          },
          "measure": {
            "$ref": "#/components/schemas/MeasureCreate"
          },
          "measures": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MeasureCreate"
            }
          },
          "telemetry": {
            "$ref": "#/components/schemas/TelemetryCreate"
          },
          "tiers": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/TierCreate"
            }
          },
          "pricing": {
            "$ref": "#/components/schemas/PricingCreate"
          }
        },
        "required": [
          "title",
          "primaryMarker"
