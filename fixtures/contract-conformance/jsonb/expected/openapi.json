          "markers": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/MarkerCreate"
            }
          },
          "measure": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MeasureCreate"
              },
              {
                "type": "null"
              }
            ]
          },
          "measures": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/MeasureCreate"
            }
          },
          "telemetry": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TelemetryCreate"
              },
              {
                "type": "null"
              }
            ]
          },
          "tiers": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "$ref": "#/components/schemas/TierCreate"
            }
          },
          "pricing": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PricingCreate"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Marker": {
        "title": "Marker",
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 40
          },
          "score": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          }
        },
        "required": [
          "label"
        ]
      },
      "MarkerCreate": {
        "title": "MarkerCreate",
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "score": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "label"
        ]
      },
      "Measure": {
        "title": "Measure",
        "type": "object",
        "properties": {
          "ratio": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "samples": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "number",
              "format": "double"
            }
          },
          "amount": {
            "type": [
              "string",
              "number",
              "null"
            ],
            "description": "A decimal. Set wire.decimals to \"string\" to fix one form across server languages. Precision 12, scale 4."
          }
        }
      },
      "MeasureCreate": {
        "title": "MeasureCreate",
        "type": "object",
        "properties": {
          "ratio": {
            "type": "number",
            "format": "double"
          },
          "samples": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            }
          },
          "amount": {
            "type": [
              "string",
              "number"
            ],
            "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
            "description": "A decimal, as a string in JSON-number grammar or a JSON number. Precision 12, scale 4."
          }
        }
      },
      "Pricing": {
        "title": "Pricing",
        "type": "object",
        "properties": {
          "tiers": {
            "type": [
              "object",
