  "components": {
    "schemas": {
      "ApiError": {
        "title": "ApiError",
        "description": "The error envelope. `error` is the stable code; `message` is free prose.",
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "field": {
            "type": "string",
            "description": "The rejected filter or sort field, on the four codes that name one."
          }
        }
      },
      "Document": {
        "title": "Document",
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "payload": {},
          "primaryMarker": {
            "$ref": "#/components/schemas/Marker"
          },
          "optionalMarker": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Marker"
              },
