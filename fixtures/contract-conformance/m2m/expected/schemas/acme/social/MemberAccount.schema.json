{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/acme/social/MemberAccount.schema.json",
  "title": "MemberAccount",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "format": "int64"
    },
    "kind": {
      "const": "Member"
    },
    "handle": {
      "type": "string",
      "maxLength": 80
    },
    "karma": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int32"
    }
  },
  "required": [
    "id",
    "kind",
    "handle",
    "karma"
  ]
}
