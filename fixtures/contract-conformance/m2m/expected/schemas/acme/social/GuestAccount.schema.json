{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/acme/social/GuestAccount.schema.json",
  "title": "GuestAccount",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "format": "int64"
    },
    "kind": {
      "const": "Guest"
    },
    "handle": {
      "type": "string",
      "maxLength": 80
    },
    "invitedBy": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 80
    }
  },
  "required": [
    "id",
    "kind",
    "handle",
    "invitedBy"
  ]
}
