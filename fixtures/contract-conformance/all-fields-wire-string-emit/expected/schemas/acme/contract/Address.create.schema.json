{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/acme/contract/Address.create.schema.json",
  "title": "Address.create",
  "description": "A postal address.",
  "type": "object",
  "properties": {
    "street": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "unit": {
      "type": "string",
      "maxLength": 10
    },
    "latitude": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
      "description": "A decimal, as a string in JSON-number grammar or a JSON number. Precision 9, scale 6."
    }
  },
  "required": [
    "street"
  ]
}
