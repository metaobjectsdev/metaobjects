  "$id": "schemas/acme/sales/Product.schema.json",
  "title": "Product",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "format": "int64"
    },
    "name": {
      "type": "string"
    },
    "sku": {
      "type": [
        "string",
        "null"
      ],
