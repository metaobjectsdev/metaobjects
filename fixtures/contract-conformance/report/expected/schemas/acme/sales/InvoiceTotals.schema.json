{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/acme/sales/InvoiceTotals.schema.json",
  "title": "InvoiceTotals",
  "type": "object",
  "properties": {
    "invoices": {
      "type": "integer",
      "format": "int64"
    },
    "totalCents": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "paidShare": {
      "type": [
        "string",
        "number",
        "null"
      ],
      "description": "A decimal. Set wire.decimals to \"string\" to fix one form across server languages."
    }
  },
  "required": [
    "invoices",
    "totalCents",
    "paidShare"
  ]
}
