{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/acme/sales/ProductRefunds.schema.json",
  "title": "ProductRefunds",
  "type": "object",
  "properties": {
    "productId": {
      "type": "integer",
      "format": "int64"
    },
    "productName": {
      "type": "string"
    },
    "sales": {
      "type": "integer",
      "format": "int64"
    },
    "hasRefund": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "hasRefundOrFalse": {
      "type": "boolean"
    }
  },
  "required": [
    "productId",
    "productName",
    "sales",
    "hasRefund",
    "hasRefundOrFalse"
  ]
}
