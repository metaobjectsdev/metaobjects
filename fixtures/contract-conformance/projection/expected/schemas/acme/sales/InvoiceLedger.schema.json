{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/acme/sales/InvoiceLedger.schema.json",
  "title": "InvoiceLedger",
  "type": "object",
  "properties": {
    "number": {
      "type": "integer",
      "format": "int64"
    },
    "reference": {
      "type": "string",
      "maxLength": 40
    },
    "discount": {
      "type": [
        "string",
        "number",
        "null"
      ],
      "description": "A decimal. Set wire.decimals to \"string\" to fix one form across server languages. Precision 10, scale 2."
    },
    "weight": {
      "type": [
        "number",
        "null"
      ],
      "format": "float"
    }
  },
  "required": [
    "number",
    "reference",
    "discount",
    "weight"
  ]
}
