{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/acme/sales/Invoice.update.schema.json",
  "title": "Invoice.update",
  "type": "object",
  "properties": {
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "status": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20
    },
    "amountCents": {
      "type": "integer",
      "format": "int64"
    },
    "discount": {
      "type": [
        "string",
        "number",
        "null"
      ],
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
      "description": "A decimal, as a string in JSON-number grammar or a JSON number. Precision 10, scale 2."
    },
    "weight": {
      "type": [
        "number",
        "null"
      ],
      "format": "float"
    }
  }
}
