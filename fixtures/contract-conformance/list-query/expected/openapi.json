          {
            "name": "search",
            "in": "query",
            "description": "A case-insensitive substring match across name, sku, category, ORed together. Empty, it is no search.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filter[or]",
            "in": "query",
            "style": "deepObject",
            "explode": true,
            "description": "Branches ORed together: filter[or][N][<field>][<op>]=<value>, each branch a filter of its own that may nest filter[or] and filter[and]. Branches are taken in index order. 5 levels are served; the next answers 400 filter.nesting_too_deep.",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "object"
              }
            }
          },
          {
            "name": "filter[and]",
            "in": "query",
            "style": "deepObject",
            "explode": true,
            "description": "Branches ANDed together: filter[and][N][<field>][<op>]=<value>, each branch a filter of its own that may nest filter[or] and filter[and]. Branches are taken in index order. 5 levels are served; the next answers 400 filter.nesting_too_deep.",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "object"
              }
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "id",
                "id:asc",
                "id:desc",
                "name",
                "name:asc",
                "name:desc",
                "sku",
                "sku:asc",
                "sku:desc",
                "category",
                "category:asc",
                "category:desc",
                "stock",
                "stock:asc",
                "stock:desc"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "withCount",
            "in": "query",
            "description": "Answer { rows, total } instead of the array.",
            "schema": {
              "type": "integer",
              "enum": [
                1
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The rows.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
