{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/acme/stockroom/Part.schema.json",
  "title": "Part",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "format": "int64"
    },
    "name": {
      "type": "string",
      "maxLength": 100
    },
    "sku": {
      "type": "string",
      "maxLength": 20
    },
    "category": {
      "type": "string",
      "enum": [
        "tool",
        "part",
        "kit"
      ]
    },
    "stock": {
      "type": "integer",
      "format": "int32"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    }
  },
  "required": [
    "id",
    "name",
    "sku",
    "category",
    "stock",
    "notes"
  ]
}
