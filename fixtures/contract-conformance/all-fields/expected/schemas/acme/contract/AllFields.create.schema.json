{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/acme/contract/AllFields.create.schema.json",
  "title": "AllFields.create",
  "description": "One field of every wire type.",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120,
      "pattern": "^(?:[A-Z].*)$",
      "description": "The display title."
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "host": {
      "type": "string",
      "format": "hostname"
    },
    "quantity": {
      "type": "integer",
      "format": "int32",
      "minimum": 0,
      "maximum": 1000
    },
    "views": {
      "type": "integer",
      "format": "int64"
    },
    "ratio": {
      "type": "number",
      "format": "double"
    },
    "score": {
      "type": "number",
      "format": "float"
    },
    "amount": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
      "description": "A decimal, as a string in JSON-number grammar or a JSON number. Precision 10, scale 2."
    },
    "active": {
      "type": "boolean"
    },
    "startsOn": {
      "type": "string",
      "format": "date"
    },
    "startsAt": {
      "type": "string",
      "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?$"
    },
    "publishedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})?$",
      "description": "An instant. A value with no offset is read as UTC."
    },
    "wallClock": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?$"
    },
    "priceCents": {
      "type": "integer",
      "format": "int64",
      "description": "Integer minor units of USD."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "live"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "early",
        "late"
      ]
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "looseLink": {
      "type": "string"
    },
    "address": {
      "type": "string",
      "anyOf": [
        {
          "format": "ipv4"
        },
        {
          "format": "ipv6"
        }
      ]
    },
    "shipTo": {
      "$ref": "./Address.create.schema.json"
    },
    "stops": {
      "type": "array",
      "items": {
        "$ref": "./Address.create.schema.json"
      },
      "minItems": 1,
      "maxItems": 5
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "issuedBy": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "quantity",
    "status"
  ]
}
