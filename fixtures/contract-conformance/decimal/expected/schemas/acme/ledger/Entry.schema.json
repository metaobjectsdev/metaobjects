{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/acme/ledger/Entry.schema.json",
  "title": "Entry",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "format": "int64"
    },
    "bucket": {
      "type": "string",
      "maxLength": 8
    },
    "amount": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
    },
    "flagged": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "bucket",
    "amount",
    "flagged"
  ]
}
