{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/acme/ledger/EntryTotals.schema.json",
  "title": "EntryTotals",
  "type": "object",
  "properties": {
    "bucket": {
      "type": "string",
      "maxLength": 8
    },
    "entries": {
      "type": "integer",
      "format": "int64"
    },
    "total": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
    },
    "totalOrZero": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
    },
    "mean": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
    },
    "top": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
    },
    "flaggedShare": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
    },
    "perFlagged": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
    }
  },
  "required": [
    "bucket",
    "entries",
    "total",
    "totalOrZero",
    "mean",
    "top",
    "flaggedShare",
    "perFlagged"
  ]
}
