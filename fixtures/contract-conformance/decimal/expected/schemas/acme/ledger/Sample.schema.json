{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/acme/ledger/Sample.schema.json",
  "title": "Sample",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "format": "int64"
    },
    "readings": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
      }
    },
    "free": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
    }
  },
  "required": [
    "id",
    "readings",
    "free"
  ]
}
