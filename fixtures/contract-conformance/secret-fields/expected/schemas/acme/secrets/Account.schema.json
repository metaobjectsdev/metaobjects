{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/acme/secrets/Account.schema.json",
  "title": "Account",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "format": "int64"
    },
    "name": {
      "type": "string",
      "maxLength": 100
    },
    "tokenHash": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 100
    }
  },
  "required": [
    "id",
    "name",
    "tokenHash"
  ]
}
