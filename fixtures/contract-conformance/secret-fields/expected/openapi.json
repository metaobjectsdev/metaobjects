  "components": {
    "schemas": {
      "Account": {
        "title": "Account",
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "tokenHash": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "role": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 20
          }
        },
        "required": [
          "id",
          "name",
          "tokenHash",
          "role"
        ]
      },
      "AccountCreate": {
        "title": "AccountCreate",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "name"
        ]
      },
      "AccountList": {
        "title": "AccountList",
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Account"
        }
      },
      "AccountPage": {
        "title": "AccountPage",
        "type": "object",
        "required": [
          "rows",
          "total"
        ],
        "properties": {
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Account"
            }
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "AccountUpdate": {
        "title": "AccountUpdate",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      },
      "ApiError": {
        "title": "ApiError",
        "description": "The error envelope. `error` is the stable code; `message` is free prose.",
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "field": {
            "type": "string",
            "description": "The rejected filter or sort field, on the four codes that name one."
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The undeclared body keys, sorted, on unknown_fields."
          },
          "issues": {
            "type": "array",
            "description": "Every problem with the body, on validation.",
            "items": {
              "type": "object",
              "required": [
                "code",
                "path",
                "message"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "description": "A Zod issue name. A client that does not know one treats it as custom."
                },
                "path": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer"
                      }
                    ]
                  },
                  "description": "The location of the field in the body."
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "maxLimit": {
            "type": "integer",
            "description": "The largest page the server serves, on limit_too_large."
          }
        }
      }
    }
  }
