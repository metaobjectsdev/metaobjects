{
  "openapi": "3.1.0",
  "info": {
    "title": "secret-fields",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounts": {
      "get": {
        "operationId": "listAccount",
        "tags": [
          "Account"
        ],
        "parameters": [
          {
            "name": "filter[id]",
            "in": "query",
            "description": "Sugar for the eq operator.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "filter[id][eq]",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "filter[id][ne]",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "filter[id][gt]",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "filter[id][gte]",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "filter[id][lt]",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "filter[id][lte]",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "filter[id][in]",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "Comma-separated values."
            }
          },
          {
            "name": "filter[id][isNull]",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "filter[name]",
            "in": "query",
            "description": "Sugar for the eq operator.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filter[name][eq]",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filter[name][ne]",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filter[name][in]",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "Comma-separated values."
            }
          },
          {
            "name": "filter[name][like]",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filter[name][isNull]",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "A case-insensitive substring match across name, ORed together. Empty, it is no search.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filter[or]",
            "in": "query",
            "style": "deepObject",
            "explode": true,
            "description": "Branches ORed together: filter[or][N][<field>][<op>]=<value>, each branch a filter of its own that may nest filter[or] and filter[and]. Branches are taken in index order. 5 levels are served; the next answers 400 filter.nesting_too_deep.",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "object"
              }
            }
          },
          {
            "name": "filter[and]",
            "in": "query",
            "style": "deepObject",
            "explode": true,
            "description": "Branches ANDed together: filter[and][N][<field>][<op>]=<value>, each branch a filter of its own that may nest filter[or] and filter[and]. Branches are taken in index order. 5 levels are served; the next answers 400 filter.nesting_too_deep.",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "object"
              }
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "id",
                "id:asc",
                "id:desc",
                "name",
                "name:asc",
                "name:desc"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "withCount",
            "in": "query",
            "description": "Answer { rows, total } instead of the array.",
            "schema": {
              "type": "integer",
              "enum": [
                1
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The rows.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/AccountList"
                    },
                    {
                      "$ref": "#/components/schemas/AccountPage"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "The request was refused.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createAccount",
        "tags": [
          "Account"
        ],
        "requestBody": {
          "required": true,
          "description": "A top-level key the model does not declare is refused with 400 unknown_fields. A declared key the client may not set, such as the generated key, is dropped.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The new row.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "400": {
            "description": "The request was refused. A body key the model does not declare answers error \"unknown_fields\" with the keys in fields, and nothing is written. Any other problem answers error \"validation\" with an issue for every problem.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "A constraint refused the write.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
