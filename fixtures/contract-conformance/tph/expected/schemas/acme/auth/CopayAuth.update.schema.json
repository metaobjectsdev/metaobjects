{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/acme/auth/CopayAuth.update.schema.json",
  "title": "CopayAuth.update",
  "type": "object",
  "properties": {
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "copayAmount": {
      "type": [
        "string",
        "number",
        "null"
      ],
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
      "description": "A decimal, as a string in JSON-number grammar or a JSON number. Precision 10, scale 2."
    }
  }
}
