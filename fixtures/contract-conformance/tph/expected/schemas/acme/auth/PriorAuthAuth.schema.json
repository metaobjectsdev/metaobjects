{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/acme/auth/PriorAuthAuth.schema.json",
  "title": "PriorAuthAuth",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "format": "int64"
    },
    "type": {
      "const": "PriorAuth"
    },
    "reference": {
      "type": "string",
      "maxLength": 80
    },
    "issuedCurrency": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 3
    },
    "autoCreatedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "autoUpdatedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "approver": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 80
    }
  },
  "required": [
    "id",
    "type",
    "reference",
    "issuedCurrency",
    "autoCreatedAt",
    "autoUpdatedAt",
    "approver"
  ]
}
