{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/acme/blog/Author.schema.json",
  "title": "Author",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "format": "int64"
    },
    "name": {
      "type": "string",
      "maxLength": 100
    },
    "bio": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1000
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "issuedCurrency": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 3
    },
    "autoCreatedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "autoUpdatedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "name",
    "bio",
    "createdAt",
    "issuedCurrency",
    "autoCreatedAt",
    "autoUpdatedAt"
  ]
}
