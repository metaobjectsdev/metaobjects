{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/acme/blog/Author.update.schema.json",
  "title": "Author.update",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "bio": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1000
    },
    "createdAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})?$",
      "description": "An instant. A value with no offset is read as UTC."
    }
  }
}
