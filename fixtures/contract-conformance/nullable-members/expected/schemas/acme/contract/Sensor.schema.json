{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/acme/contract/Sensor.schema.json",
  "title": "Sensor",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "format": "int64"
    },
    "reading": {
      "anyOf": [
        {
          "$ref": "./Reading.schema.json"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "reading"
  ]
}
