              }
            }
          },
          "400": {
            "description": "The id is not one the key column can hold: error \"invalid_id\".",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "No such row.",
            "content": {
              "application/json": {
