{
  "openapi": "3.1.0",
  "info": {
    "title": "nullable-members",
    "version": "1.0.0"
  },
  "paths": {
    "/api/sensors": {
      "get": {
        "operationId": "listSensor",
        "tags": [
          "Sensor"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Rows per page. Absent, the server answers 50.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "withCount",
            "in": "query",
            "description": "Answer { rows, total } instead of the array.",
            "schema": {
              "type": "integer",
              "enum": [
                1
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The rows.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/SensorList"
                    },
                    {
                      "$ref": "#/components/schemas/SensorPage"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "The request was refused.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createSensor",
        "tags": [
          "Sensor"
        ],
        "requestBody": {
          "required": true,
          "description": "A top-level key the model does not declare is refused with 400 unknown_fields. A declared key the client may not set, such as the generated key, is dropped.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SensorCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The new row.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sensor"
                }
              }
            }
          },
          "400": {
            "description": "The request was refused. A body key the model does not declare answers error \"unknown_fields\" with the keys in fields, and nothing is written. Any other problem answers error \"validation\" with an issue for every problem.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "A constraint refused the write.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sensors/{id}": {
