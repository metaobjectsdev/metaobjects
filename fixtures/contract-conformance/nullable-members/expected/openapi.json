  },
  "components": {
    "schemas": {
      "ApiError": {
        "title": "ApiError",
        "description": "The error envelope. `error` is the stable code; `message` is free prose.",
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "field": {
            "type": "string",
            "description": "The rejected filter or sort field, on the four codes that name one."
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The undeclared body keys, sorted, on unknown_fields."
          },
          "issues": {
            "type": "array",
            "description": "Every problem with the body, on validation.",
            "items": {
              "type": "object",
              "required": [
                "code",
                "path",
                "message"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "description": "A Zod issue name. A client that does not know one treats it as custom."
                },
                "path": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer"
                      }
                    ]
                  },
                  "description": "The location of the field in the body."
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "maxLimit": {
            "type": "integer",
            "description": "The largest page the server serves, on limit_too_large."
          }
        }
      },
      "Place": {
        "title": "Place",
        "type": "object",
        "properties": {
          "city": {
            "type": "string"
          }
        },
        "required": [
          "city"
        ]
      },
      "PlaceCreate": {
        "title": "PlaceCreate",
        "type": "object",
        "properties": {
          "city": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "city"
        ]
      },
      "Reading": {
        "title": "Reading",
        "type": "object",
        "properties": {
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "grade": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "LOW",
              "HIGH",
              null
            ]
          },
          "place": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Place"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "ReadingCreate": {
        "title": "ReadingCreate",
        "type": "object",
        "properties": {
          "unit": {
            "type": "string"
          },
          "grade": {
            "type": "string",
            "enum": [
              "LOW",
              "HIGH"
            ]
          },
          "place": {
            "$ref": "#/components/schemas/PlaceCreate"
          }
        }
      },
      "Sensor": {
        "title": "Sensor",
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "reading": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Reading"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "reading"
        ]
      },
      "SensorCreate": {
        "title": "SensorCreate",
        "type": "object",
        "properties": {
          "reading": {
            "$ref": "#/components/schemas/ReadingCreate"
          }
        }
      },
      "SensorList": {
        "title": "SensorList",
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Sensor"
        }
      },
      "SensorPage": {
        "title": "SensorPage",
        "type": "object",
        "required": [
          "rows",
          "total"
        ],
        "properties": {
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Sensor"
            }
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "SensorSummary": {
        "title": "SensorSummary",
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "reading": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Reading"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "reading"
        ]
      },
      "SensorSummaryList": {
        "title": "SensorSummaryList",
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/SensorSummary"
        }
      },
      "SensorSummaryPage": {
        "title": "SensorSummaryPage",
        "type": "object",
        "required": [
          "rows",
          "total"
        ],
        "properties": {
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SensorSummary"
            }
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "SensorUpdate": {
        "title": "SensorUpdate",
        "type": "object",
        "properties": {
          "reading": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReadingCreate"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
