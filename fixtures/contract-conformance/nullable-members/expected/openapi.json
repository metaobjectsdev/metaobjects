          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SensorUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The row.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sensor"
                }
              }
            }
          },
          "400": {
            "description": "The request was refused. A body key the model does not declare answers error \"unknown_fields\" with the keys in fields, and nothing is written. Any other problem answers error \"validation\" with an issue for every problem. An id the key column cannot hold answers error \"invalid_id\".",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "No such row.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "A constraint refused the write.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "putSensor",
        "tags": [
          "Sensor"
        ],
        "requestBody": {
          "required": true,
          "description": "A top-level key the model does not declare is refused with 400 unknown_fields. A declared key the client may not set, such as the generated key, is dropped.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SensorUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The row.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sensor"
                }
              }
            }
          },
          "400": {
            "description": "The request was refused. A body key the model does not declare answers error \"unknown_fields\" with the keys in fields, and nothing is written. Any other problem answers error \"validation\" with an issue for every problem. An id the key column cannot hold answers error \"invalid_id\".",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "No such row.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "A constraint refused the write.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteSensor",
        "tags": [
          "Sensor"
        ],
        "responses": {
          "204": {
            "description": "Deleted."
          },
          "400": {
            "description": "The id is not one the key column can hold: error \"invalid_id\".",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "No such row.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "A constraint refused the write.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sensor_summaries": {
      "get": {
        "operationId": "listSensorSummary",
        "tags": [
          "SensorSummary"
        ],
        "description": "Read-only: a write to this resource answers 405 {\"error\": \"method_not_allowed\"}.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Rows per page. Absent, the server answers 50.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "withCount",
            "in": "query",
            "description": "Answer { rows, total } instead of the array.",
            "schema": {
              "type": "integer",
              "enum": [
                1
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The rows.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/SensorSummaryList"
                    },
                    {
                      "$ref": "#/components/schemas/SensorSummaryPage"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "The request was refused.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sensor_summaries/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        }
      ],
      "get": {
        "operationId": "getSensorSummary",
        "tags": [
          "SensorSummary"
        ],
        "description": "Read-only: a write to this resource answers 405 {\"error\": \"method_not_allowed\"}.",
        "responses": {
          "200": {
            "description": "The row.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SensorSummary"
                }
              }
            }
          },
          "400": {
            "description": "The id is not one the key column can hold: error \"invalid_id\".",
            "content": {
