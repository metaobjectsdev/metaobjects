          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        }
      ],
      "get": {
        "operationId": "getSensor",
        "tags": [
          "Sensor"
        ],
        "responses": {
          "200": {
