{
  "metadata.root": {
    "package": "acme::shop",
    "children": [
      {
        "object.entity": {
          "name": "BaseEntity",
          "abstract": true,
          "children": [
            { "field.uuid": { "name": "id" } },
            { "field.timestamp": { "name": "createdAt" } },
            { "identity.primary": { "name": "pk", "@fields": ["id"] } }
          ]
        }
      },
      {
        "object.value": {
          "name": "Address",
          "children": [
            { "field.string": { "name": "street" } },
            { "field.string": { "name": "city" } }
          ]
        }
      },
      {
        "object.entity": {
          "name": "Customer",
          "extends": "BaseEntity",
          "children": [
            { "field.string": { "name": "name", "@required": true } },
            { "field.string": { "name": "email" } },
            { "field.object": { "name": "shippingAddress", "@objectRef": "Address" } },
            { "source.rdb": { "name": "db", "@table": "customers" } }
          ]
        }
      },
      {
        "object.entity": {
          "name": "Order",
          "extends": "BaseEntity",
          "children": [
            { "field.uuid": { "name": "customerId" } },
            { "field.string": { "name": "reference" } },
            { "field.decimal": { "name": "total" } },
            { "field.enum": { "name": "state", "@values": ["OPEN", "PAID", "SHIPPED"] } },
            { "identity.reference": { "name": "customerRef", "@fields": ["customerId"], "@references": "Customer" } },
            { "index.lookup": { "name": "orderByCustomerId", "@fields": ["customerId"] } },
            { "source.rdb": { "name": "db", "@table": "orders" } }
          ]
        }
      },
      {
        "object.entity": {
          "name": "AuditEntry",
          "children": [
            { "field.uuid": { "name": "id" } },
            { "identity.primary": { "name": "pk", "@fields": ["id"] } },
            { "field.string": { "name": "message" } },
            { "source.rdb": { "name": "db", "@table": "audit_entries" } }
          ]
        }
      },
      {
        "object.value": {
          "name": "OrderNoteRequest",
          "children": [
            { "field.string": { "name": "reference", "@required": true } }
          ]
        }
      },
      {
        "object.value": {
          "name": "OrderNote",
          "children": [
            { "field.string": { "name": "text", "@required": true } }
          ]
        }
      },
      {
        "template.prompt": {
          "name": "OrderNotePrompt",
          "@payloadRef": "OrderNoteRequest",
          "@responseRef": "OrderNote",
          "@textRef": "shop/order-note",
          "@format": "text",
          "@responseFormat": "json"
        }
      },
      {
        "requirement.architectural": {
          "name": "Addressable",
          "@status": "live",
          "@statement": "Every stored row has a stable id.",
          "@counterexample": "A row nobody can point at.",
          "@implementedBy": ["BaseEntity"]
        }
      },
      {
        "requirement.functional": {
          "name": "Shop",
          "@level": 1,
          "@status": "live",
          "@statement": "A customer can buy from the shop.",
          "@counterexample": "A customer who cannot place an order.",
          "children": [
            {
              "requirement.functional": {
                "name": "Checkout",
                "@level": 2,
                "@status": "partial",
                "@disposition": "deferred",
                "@trackedBy": ["https://example.invalid/issues/1"],
                "@statement": "Orders are taken at checkout.",
                "@counterexample": "An order taken outside checkout.",
                "children": [
                  {
                    "requirement.functional": {
                      "name": "Orders",
                      "@level": 3,
                      "@status": "live",
                      "@statement": "Every placed order is kept.",
                      "@counterexample": "A placed order that is lost.",
                      "children": [
                        {
                          "requirement.functional": {
                            "name": "Recorded",
                            "@level": 4,
                            "@status": "live",
                            "@statement": "An order is recorded when it is placed.",
                            "@counterexample": "A placed order has no row.",
                            "@implementedBy": ["Order", "Customer"],
                            "children": [
                              {
                                "requirement.functional": {
                                  "name": "Quotable",
                                  "@level": 5,
                                  "@status": "live",
                                  "@statement": "An order carries a reference the customer can quote.",
                                  "@counterexample": "An order nobody can quote back.",
                                  "@implementedBy": ["Order.reference"]
                                }
                              }
                            ]
                          }
                        },
                        {
                          "requirement.functional": {
                            "name": "Noted",
                            "@level": 4,
                            "@status": "live",
                            "@statement": "A placed order gets a short note for the customer.",
                            "@counterexample": "An order with no note.",
                            "@implementedBy": ["OrderNotePrompt"]
                          }
                        },
                        {
                          "requirement.functional": {
                            "name": "Refunded",
                            "@level": 4,
                            "@status": "planned",
                            "@statement": "A paid order can be refunded.",
                            "@counterexample": "A paid order that cannot be refunded.",
                            "@implementedBy": ["Refund"]
                          }
                        }
                      ]
                    }
                  },
                  {
                    "requirement.functional": {
                      "name": "Shipping",
                      "@level": 3,
                      "@status": "live",
                      "@statement": "A paid order is shipped.",
                      "@counterexample": "A paid order that never ships."
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
