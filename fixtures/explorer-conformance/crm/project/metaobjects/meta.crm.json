{
  "metadata.root": {
    "package": "acme::crm",
    "children": [
      {
        "page.list": {
          "name": "Lead",
          "@title": "Leads",
          "@objectRef": "Lead",
          "@route": "/leads",
          "children": [
            { "block.table": { "name": "leads", "@objectRef": "Lead", "@columns": ["email", "accountId"] } },
            { "block.table": { "name": "accounts", "@objectRef": "Account", "@columns": ["name"] } }
          ]
        }
      },
      {
        "object.entity": {
          "name": "Scored",
          "abstract": true,
          "children": [
            { "field.long": { "name": "score" } }
          ]
        }
      },
      {
        "object.entity": {
          "name": "Lead",
          "extends": "Scored",
          "@description": "A prospective customer.",
          "children": [
            { "field.long": { "name": "id" } },
            { "field.string": { "name": "email" } },
            { "field.long": { "name": "accountId" } },
            { "identity.primary": { "name": "pk", "@fields": ["id"] } },
            { "identity.reference": { "name": "accountRef", "@fields": ["accountId"], "@references": "Account" } },
            { "source.rdb": { "name": "db", "@table": "leads" } }
          ]
        }
      },
      {
        "object.entity": {
          "name": "Account",
          "children": [
            { "field.long": { "name": "id" } },
            { "field.string": { "name": "name" } },
            { "relationship.association": { "name": "leads", "@objectRef": "Lead", "@cardinality": "many" } },
            { "identity.primary": { "name": "pk", "@fields": ["id"] } },
            { "source.rdb": { "name": "db", "@table": "accounts" } }
          ]
        }
      },
      {
        "object.value": {
          "name": "ScoreParams",
          "children": [
            { "field.long": { "name": "accountId" } }
          ]
        }
      },
      {
        "object.projection": {
          "name": "AccountScore",
          "children": [
            { "source.rdb": { "@kind": "storedProc", "@proc": "account_score", "@parameterRef": "ScoreParams" } },
            {
              "field.long": {
                "name": "totalScore",
                "children": [
                  { "origin.aggregate": { "@agg": "sum", "@of": "Lead.score", "@via": "Account.leads" } }
                ]
              }
            }
          ]
        }
      },
      {
        "requirement.functional": {
          "name": "Crm",
          "@level": 1,
          "@status": "live",
          "@statement": "The software tracks leads and the accounts they belong to.",
          "@counterexample": "A lead is recorded with no account it can be traced to.",
          "children": [
            {
              "requirement.functional": {
                "name": "Leads",
                "@level": 4,
                "@status": "live",
                "@statement": "Each lead is stored with its email and account.",
                "@counterexample": "A lead's email is lost on save.",
                "@implementedBy": ["Lead", "Account", "acme::tax::tax"],
                "children": [
                  {
                    "requirement.functional": {
                      "name": "Scoring",
                      "@level": 5,
                      "@status": "live",
                      "@statement": "Each lead carries a score its account totals.",
                      "@counterexample": "A lead whose score is left out of its account's total.",
                      "@implementedBy": ["Lead.score"]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
