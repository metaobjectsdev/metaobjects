{
  "metadata.root": {
    "package": "acme::billing",
    "children": [
      {
        "object.value": {
          "name": "Money",
          "children": [
            {
              "field.decimal": {
                "name": "amount",
                "@required": true,
                "@precision": 12,
                "@scale": 2
              }
            },
            {
              "field.string": {
                "name": "currency",
                "@required": true,
                "@maxLength": 3
              }
            }
          ]
        }
      },
      {
        "object.entity": {
          "name": "Payment",
          "children": [
            {
              "source.rdb": {
                "@table": "payments"
              }
            },
            {
              "field.long": {
                "name": "id"
              }
            },
            {
              "field.string": {
                "name": "kind"
              }
            },
            {
              "field.date": {
                "name": "receivedOn",
                "@required": true
              }
            },
            {
              "field.object": {
                "name": "amount",
                "@objectRef": "Money",
                "@storage": "flattened",
                "@required": true
              }
            },
            {
              "identity.primary": {
                "name": "id",
                "@fields": [
                  "id"
                ]
              }
            },
            {
              "dimension.attribute": {
                "name": "currency",
                "@of": "Payment.amount.currency"
              }
            },
            {
              "dimension.attribute": {
                "name": "kind",
                "@of": "Payment.kind"
              }
            },
            {
              "dimension.time": {
                "name": "receivedOn",
                "@of": "Payment.receivedOn",
                "@grains": [
                  "month"
                ]
              }
            },
            {
              "measure.aggregate": {
                "name": "revenue",
                "@agg": "sum",
                "@of": "Payment.amount.amount"
              }
            },
            {
              "measure.aggregate": {
                "name": "largest",
                "@agg": "max",
                "@of": "Payment.amount.amount",
                "@default": 0
              }
            },
            {
              "measure.aggregate": {
                "name": "currencies",
                "@agg": "count",
                "@distinct": true,
                "@of": "Payment.amount.currency"
              }
            },
            {
              "measure.aggregate": {
                "name": "payments",
                "@agg": "count",
                "@of": "Payment.id"
              }
            },
            {
              "measure.ratio": {
                "name": "averagePayment",
                "@numerator": "revenue",
                "@denominator": "payments"
              }
            }
          ]
        }
      },
      {
        "object.report": {
          "name": "RevenueByMonth",
          "@from": "Payment",
          "@dimensions": [
            "currency",
            "kind",
            "receivedOn:month"
          ],
          "@measures": [
            "revenue",
            "largest",
            "averagePayment",
            "payments"
          ],
          "children": [
            {
              "source.rdb": {
                "@kind": "view",
                "@view": "v_revenuebymonth"
              }
            }
          ]
        }
      },
      {
        "object.report": {
          "name": "CurrencyMix",
          "@from": "Payment",
          "@dimensions": [
            "kind"
          ],
          "@measures": [
            "currencies",
            "payments"
          ],
          "children": [
            {
              "source.rdb": {
                "@kind": "view",
                "@view": "v_currencymix"
              }
            }
          ]
        }
      }
    ]
  }
}
