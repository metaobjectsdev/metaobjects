{
  "metadata.root": {
    "package": "acme::views",
    "children": [
      {
        "object.entity": {
          "name": "Case",
          "children": [
            {
              "source.rdb": {
                "@table": "cases"
              }
            },
            {
              "field.long": {
                "name": "id"
              }
            },
            {
              "field.enum": {
                "name": "status",
                "@values": [
                  "PAID",
                  "REFUNDED"
                ]
              }
            },
            {
              "field.int": {
                "name": "priority"
              }
            },
            {
              "identity.primary": {
                "name": "id",
                "@fields": "id"
              }
            }
          ]
        }
      },
      {
        "object.projection": {
          "name": "CaseLabels",
          "children": [
            {
              "source.rdb": {
                "@kind": "view",
                "@view": "v_case_labels"
              }
            },
            {
              "field.long": {
                "name": "id",
                "extends": "acme::views::Case.id"
              }
            },
            {
              "field.string": {
                "name": "label",
                "children": [
                  {
                    "origin.computed": {
                      "@expr": {
                        "case": [
                          {
                            "when": {
                              "value": "PAYD"
                            },
                            "then": {
                              "value": "Paid"
                            }
                          }
                        ],
                        "operand": {
                          "field": "status"
                        },
                        "else": {
                          "value": "Other"
                        }
                      }
                    }
                  }
                ]
              }
            },
            {
              "identity.primary": {
                "name": "id",
                "extends": "acme::views::Case.id"
              }
            }
          ]
        }
      }
    ]
  }
}
