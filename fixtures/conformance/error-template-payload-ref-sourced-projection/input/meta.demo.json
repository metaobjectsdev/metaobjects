{
  "metadata.root": {
    "package": "demo",
    "children": [
      {
        "object.entity": {
          "name": "Author",
          "children": [
            { "source.rdb": { "@table": "authors" } },
            { "field.uuid": { "name": "id" } },
            { "field.string": { "name": "name", "@maxLength": 200 } },
            { "identity.primary": { "name": "pk", "@fields": ["id"] } }
          ]
        }
      },
      {
        "object.projection": {
          "name": "AuthorView",
          "children": [
            { "source.rdb": { "@kind": "view", "@view": "v_author" } },
            { "field.string": { "name": "name", "extends": "demo::Author.name" } }
          ]
        }
      },
      {
        "template.prompt": {
          "name": "authorPrompt",
          "@payloadRef": "demo::AuthorView",
          "@textRef": "prompt/author",
          "@format": "xml"
        }
      }
    ]
  }
}
