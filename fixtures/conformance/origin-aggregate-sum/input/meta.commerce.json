{
  "metadata": {
    "package": "acme::commerce",
    "children": [
      {
        "object": {
          "name": "Program",
          "subType": "entity",
          "children": [
            { "field": { "name": "id", "subType": "long" } },
            { "field": { "name": "title", "subType": "string" } },
            { "relationship": { "name": "weeks", "subType": "association", "@objectRef": "Week" } },
            { "identity": { "subType": "primary", "@fields": "id" } }
          ]
        }
      },
      {
        "object": {
          "name": "Week",
          "subType": "entity",
          "children": [
            { "field": { "name": "id", "subType": "long" } },
            { "field": { "name": "durationMinutes", "subType": "int" } },
            { "identity": { "subType": "primary", "@fields": "id" } }
          ]
        }
      },
      {
        "object": {
          "name": "ProgramSummary",
          "subType": "entity",
          "extends": "Program",
          "children": [
            { "source": { "subType": "dbView", "@name": "v_program_summary" } },
            { "field": {
                "name": "totalMinutes",
                "subType": "int",
                "children": [
                  { "origin": { "subType": "aggregate", "@agg": "sum", "@of": "Week.durationMinutes", "@via": "Program.weeks" } }
                ]
            } },
            { "identity": { "subType": "primary", "@fields": "id" } }
          ]
        }
      }
    ]
  }
}
