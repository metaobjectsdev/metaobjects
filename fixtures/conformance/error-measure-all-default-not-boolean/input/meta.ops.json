                "@fields": [
                  "id"
                ]
              }
            },
            {
              "measure.aggregate": {
                "name": "allFailed",
                "@agg": "all",
                "@of": "Call.failed",
                "@default": 2
              }
            }
          ]
        }
      }
    ]
  }
}
