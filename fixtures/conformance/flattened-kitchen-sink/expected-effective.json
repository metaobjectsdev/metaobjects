            {
              "field.string": {
                "name": "sku"
              }
            },
            {
              "field.string": {
                "name": "name"
              }
            },
            {
              "field.string": {
                "name": "tags",
                "isArray": true,
                "children": [
                  {
                    "validator.array": {
                      "@max": 5,
                      "@min": 1
                    }
                  }
                ]
              }
            },
            {
              "field.enum": {
                "name": "status",
                "extends": "acme::common::Lifecycle",
                "@description": "Reusable lifecycle enum — extended by concrete enum fields.",
