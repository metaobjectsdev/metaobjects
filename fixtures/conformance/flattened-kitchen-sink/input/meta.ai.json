{
  "metadata.root": {
    "package": "acme::ai",
    "children": [
      {
        "object.value": {
          "name": "ProductPromptPayload",
          "@description": "Typed projection passed to the product prompt/output/toolcall templates.",
          "children": [
            { "field.string": { "name": "sku" } },
            { "field.string": { "name": "name" } },
            { "field.string": {
                "name": "tags",
                "isArray": true,
                "children": [ { "validator.array": { "@min": 1, "@max": 5 } } ]
              }
            },
            { "field.enum": { "name": "status", "extends": "acme::common::Lifecycle" } }
          ]
        }
      },
      {
        "object.value": {
          "name": "ProductDescription",
          "@description": "The typed shape describeProduct expects back from the model.",
          "children": [
            { "field.string": { "name": "headline" } },
            { "field.string": { "name": "body" } }
          ]
        }
      },
      {
        "template.prompt": {
          "name": "describeProduct",
          "@payloadRef": "acme::ai::ProductPromptPayload",
          "@responseRef": "acme::ai::ProductDescription",
          "@textRef": "product/describe",
          "@format": "xml",
          "@responseFormat": "json",
          "@promptStyle": "guide"
        }
      },
      {
        "template.output": {
          "name": "productCard",
          "@payloadRef": "acme::ai::ProductPromptPayload",
          "@textRef": "product/card",
          "@format": "html"
        }
      },
      {
        "template.toolcall": {
          "name": "lookupProduct",
          "@toolName": "lookup_product",
          "@payloadRef": "acme::ai::ProductPromptPayload"
        }
      }
    ]
  }
}
