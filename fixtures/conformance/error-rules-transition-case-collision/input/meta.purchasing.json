{
  "metadata.root": {
    "package": "acme::purchasing",
    "children": [
      {
        "object.entity": {
          "name": "PurchaseRequest",
          "children": [
            {
              "source.rdb": {
                "@table": "purchase_requests"
              }
            },
            {
              "field.long": {
                "name": "id"
              }
            },
            {
              "identity.primary": {
                "name": "pk",
                "@fields": [
                  "id"
                ]
              }
            },
            {
              "field.string": {
                "name": "title"
              }
            },
            {
              "field.enum": {
                "name": "status",
                "@values": [
                  "draft",
                  "submitted",
                  "approved",
                  "rejected"
                ],
                "@default": "draft",
                "children": [
                  {
                    "transition.action": {
                      "name": "close",
                      "@from": [
                        "draft"
                      ],
                      "@to": "rejected"
                    }
                  },
                  {
                    "transition.action": {
                      "name": "Close",
                      "@from": [
                        "submitted"
                      ],
                      "@to": "rejected"
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
