{
  "metadata.root": {
    "package": "acme::commerce",
    "children": [
      {
        "object.entity": {
          "name": "Program",
          "children": [
            {
              "field.long": {
                "name": "id"
              }
            },
            {
              "field.string": {
                "name": "title"
              }
            },
            {
              "identity.primary": {
                "name": "id",
                "@fields": "id"
              }
            }
          ]
        }
      },
      {
        "object.projection": {
          "name": "ProgramSummary",
          "children": [
            {
              "source.rdb": {
                "@kind": "view",
                "@view": "v_program_summary"
              }
            },
            {
              "field.int": {
                "name": "weekCount",
                "children": [
                  {
                    "origin.aggregate": {
                      "@agg": "count",
                      "@of": "Program.id",
                      "@via": "Program.notARealRelationship"
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
