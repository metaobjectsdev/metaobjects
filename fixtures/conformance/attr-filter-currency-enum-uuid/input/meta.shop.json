{
  "metadata.root": {
    "package": "acme",
    "children": [
      {
        "object.entity": {
          "name": "Order",
          "children": [
            {
              "field.uuid": {
                "name": "ref",
                "@filterable": true
              }
            },
            {
              "field.currency": {
                "name": "total",
                "@currency": "USD",
                "@filterable": true
              }
            },
            {
              "field.enum": {
                "name": "status",
                "@values": ["pending", "paid", "shipped"],
                "@filterable": true
              }
            },
            {
              "identity.primary": {
                "name": "id",
                "@fields": ["ref"]
              }
            },
            {
              "identity.secondary": {
                "name": "byTotal",
                "@fields": ["total"]
              }
            },
            {
              "identity.secondary": {
                "name": "byStatus",
                "@fields": ["status"]
              }
            }
          ]
        }
      }
    ]
  }
}
