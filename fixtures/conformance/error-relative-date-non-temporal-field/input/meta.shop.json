{
  "metadata.root": {
    "package": "acme::shop",
    "children": [
      {
        "object.entity": {
          "name": "Program",
          "children": [
            {
              "source.rdb": {
                "@table": "programs"
              }
            },
            {
              "field.long": {
                "name": "id"
              }
            },
            {
              "identity.primary": {
                "name": "id",
                "@fields": [
                  "id"
                ]
              }
            },
            {
              "relationship.association": {
                "name": "purchases",
                "@objectRef": "Purchase",
                "@cardinality": "many"
              }
            }
          ]
        }
      },
      {
        "object.entity": {
          "name": "Purchase",
          "children": [
            {
              "source.rdb": {
                "@table": "purchases"
              }
            },
            {
              "field.long": {
                "name": "id"
              }
            },
            {
              "field.long": {
                "name": "programId"
              }
            },
            {
              "field.currency": {
                "name": "amountCents"
              }
            },
            {
              "field.timestamp": {
                "name": "purchasedAt"
              }
            },
            {
              "identity.primary": {
                "name": "id",
                "@fields": [
                  "id"
                ]
              }
            },
            {
              "identity.reference": {
                "name": "programRef",
                "@references": "Program",
                "@fields": [
                  "programId"
                ]
              }
            }
          ]
        }
      },
      {
        "object.projection": {
          "name": "ProgramPurchaseCounts",
          "children": [
            {
              "source.rdb": {
                "@kind": "view",
                "@view": "program_purchase_counts"
              }
            },
            {
              "field.long": {
                "name": "id",
                "extends": "Program.id"
              }
            },
            {
              "field.int": {
                "name": "recentPurchaseCount",
                "children": [
                  {
                    "origin.aggregate": {
                      "@agg": "count",
                      "@of": "Purchase.id",
                      "@via": "Program.purchases",
                      "@filter": {
                        "programId": {
                          "gte": {
                            "now": "-P7D"
                          }
                        }
                      }
                    }
                  }
                ]
              }
            },
            {
              "identity.primary": {
                "name": "id",
                "extends": "Program.id"
              }
            }
          ]
        }
      },
      {
        "object.projection": {
          "name": "RecentPurchase",
          "@filter": {
            "amountCents": {
              "gte": {
                "now": "-P7D"
              }
            }
          },
          "children": [
            {
              "source.rdb": {
                "@kind": "view",
                "@view": "recent_purchases"
              }
            },
            {
              "field.long": {
                "name": "id",
                "extends": "Purchase.id"
              }
            },
            {
              "field.currency": {
                "name": "amountCents",
                "extends": "Purchase.amountCents"
              }
            },
            {
              "identity.primary": {
                "name": "id",
                "extends": "Purchase.id"
              }
            }
          ]
        }
      }
    ]
  }
}
