{
  "metadata.root": {
    "package": "acme::commerce",
    "children": [
      {
        "object.entity": {
          "name": "Program",
          "children": [
            {
              "source.rdb": {
                "@table": "programs"
              }
            },
            {
              "field.long": {
                "name": "id"
              }
            },
            {
              "field.string": {
                "name": "title"
              }
            },
            {
              "field.enum": {
                "name": "status",
                "@values": [
                  "draft",
                  "active"
                ],
                "@default": "draft",
                "children": [
                  {
                    "transition.action": {
                      "name": "activate",
                      "@from": [
                        "draft"
                      ],
                      "@to": "active"
                    }
                  }
                ]
              }
            },
            {
              "identity.primary": {
                "name": "id",
                "@fields": "id"
              }
            }
          ]
        }
      }
    ]
  }
}
