{
  "metadata.root": {
    "package": "acme::views",
    "children": [
      {
        "object.entity": {
          "name": "Status",
          "children": [
            {
              "source.rdb": {
                "@table": "statuses"
              }
            },
            {
              "field.long": {
                "name": "id"
              }
            },
            {
              "field.string": {
                "name": "name"
              }
            },
            {
              "identity.primary": {
                "name": "id",
                "@fields": [
                  "id"
                ]
              }
            }
          ]
        }
      },
      {
        "object.entity": {
          "name": "Consignment",
          "children": [
            {
              "source.rdb": {
                "@table": "consignments"
              }
            },
            {
              "field.long": {
                "name": "id"
              }
            },
            {
              "field.long": {
                "name": "statusId"
              }
            },
            {
              "field.int": {
                "name": "serviceLevel"
              }
            },
            {
              "field.int": {
                "name": "rollupStatus"
              }
            },
            {
              "field.int": {
                "name": "status"
              }
            },
            {
              "field.date": {
                "name": "effectiveFrom"
              }
            },
            {
              "identity.primary": {
                "name": "id",
                "@fields": [
                  "id"
                ]
              }
            },
            {
              "identity.reference": {
                "name": "statusId",
                "@fields": [
                  "statusId"
                ],
                "@references": "acme::views::Status"
              }
            }
          ]
        }
      },
      {
        "object.entity": {
          "name": "ConsignmentHistory",
          "@collectionName": "ConsignmentHistory",
          "children": [
            {
              "source.rdb": {
                "@table": "consignment_history"
              }
            },
            {
              "field.long": {
                "name": "id"
              }
            },
            {
              "field.long": {
                "name": "consignmentId",
                "@required": true
              }
            },
            {
              "field.long": {
                "name": "statusId"
              }
            },
            {
              "field.timestamp": {
                "name": "createdDate"
              }
            },
            {
              "field.boolean": {
                "name": "active"
              }
            },
            {
              "identity.primary": {
                "name": "id",
                "@fields": [
                  "id"
                ]
              }
            },
            {
              "identity.reference": {
                "name": "consignmentId",
                "@fields": [
                  "consignmentId"
                ],
                "@references": "acme::views::Consignment"
              }
            },
            {
              "segment.filter": {
                "name": "live",
                "@filter": {
                  "active": {
                    "eq": true
                  }
                }
              }
            }
          ]
        }
      },
      {
        "object.projection": {
          "name": "CasePlacement",
          "children": [
            {
              "source.rdb": {
                "@kind": "view",
                "@view": "v_caseplacement"
              }
            },
            {
              "field.long": {
                "name": "id",
                "extends": "acme::views::Consignment.id"
              }
            },
            {
              "field.timestamp": {
                "name": "statusPlaced",
                "children": [
                  {
                    "origin.aggregate": {
                      "@agg": "min",
                      "@filter": {
                        "statusId": {
                          "eq": {
                            "field": "statusId"
                          }
                        }
                      },
                      "@of": "acme::views::ConsignmentHistory.createdDate",
                      "@segment": "live",
                      "@via": "acme::views::Consignment.consignmentHistory"
                    }
                  }
                ]
              }
            },
            {
              "field.long": {
                "name": "otherStatus",
                "children": [
                  {
                    "origin.first": {
                      "@filter": {
                        "statusId": {
                          "isDistinctFrom": {
                            "field": "statusId"
                          }
                        }
                      },
                      "@of": "acme::views::ConsignmentHistory.statusId",
                      "@orderBy": [
                        "statusId"
                      ],
                      "@segment": "live",
                      "@via": "acme::views::Consignment.consignmentHistory"
                    }
                  }
                ]
              }
            },
            {
              "identity.primary": {
                "name": "id",
                "extends": "acme::views::Consignment.id"
              }
            }
          ]
        }
      }
    ]
  }
