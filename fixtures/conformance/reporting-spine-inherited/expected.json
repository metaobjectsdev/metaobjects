{
  "metadata.root": {
    "package": "acme::shop",
    "children": [
      {
        "object.entity": {
          "name": "Program",
          "children": [
            {
              "source.rdb": {
                "@table": "programs"
              }
            },
            {
              "field.long": {
                "name": "id"
              }
            },
            {
              "field.string": {
                "name": "title",
                "@required": true
              }
            },
            {
              "identity.primary": {
                "name": "id",
                "@fields": [
                  "id"
                ]
              }
            }
          ]
        }
      },
      {
        "object.entity": {
          "name": "BaseEvent",
          "abstract": true,
          "children": [
            {
              "field.long": {
                "name": "id"
              }
            },
            {
              "field.long": {
                "name": "programId"
              }
            },
            {
              "field.int": {
                "name": "minutes"
              }
            },
            {
              "identity.reference": {
                "name": "fkProgram",
                "@fields": [
                  "programId"
                ],
                "@references": "acme::shop::Program"
              }
            },
            {
              "relationship.association": {
                "name": "program",
                "@cardinality": "one",
                "@objectRef": "acme::shop::Program"
              }
            },
            {
              "dimension.attribute": {
                "name": "programId",
                "@of": "acme::shop::Program.id",
                "@via": "acme::shop::BaseEvent.program"
              }
            },
            {
              "dimension.attribute": {
                "name": "programTitle",
                "@of": "acme::shop::Program.title",
                "@via": "acme::shop::BaseEvent.program"
              }
            },
            {
              "measure.aggregate": {
                "name": "totalMinutes",
                "@agg": "sum",
                "@default": 0,
                "@of": [
                  "acme::shop::BaseEvent.minutes"
                ]
              }
            }
          ]
        }
      },
      {
        "object.entity": {
          "name": "WorkoutEvent",
          "extends": "acme::shop::BaseEvent",
          "children": [
            {
              "source.rdb": {
                "@table": "workout_events"
              }
            },
            {
              "field.string": {
                "name": "eventType"
              }
            },
            {
              "identity.primary": {
                "name": "id",
                "@fields": [
                  "id"
                ]
              }
            }
          ]
        }
      },
      {
        "object.report": {
          "name": "ProgramMinutes",
          "@dimensions": [
            "programId",
            "programTitle"
          ],
          "@from": "acme::shop::WorkoutEvent",
          "@measures": [
            "totalMinutes"
          ],
          "@spine": "acme::shop::BaseEvent.program"
        }
      }
    ]
  }
}
