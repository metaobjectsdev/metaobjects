              }
            },
            {
              "identity.primary": {
                "@fields": "id"
              }
            }
          ]
        }
      },
      {
        "object.entity": {
          "name": "Week",
          "children": [
            {
              "field.long": {
                "name": "id"
              }
            },
            {
              "relationship.association": {
                "name": "workouts",
                "@objectRef": "Workout"
              }
            },
            {
              "identity.primary": {
                "@fields": "id"
              }
            }
          ]
        }
      },
      {
        "object.entity": {
          "name": "Workout",
          "children": [
            {
              "field.long": {
                "name": "id"
              }
            },
            {
              "field.string": {
                "name": "name"
              }
            },
            {
              "identity.primary": {
                "@fields": "id"
              }
            }
          ]
        }
      },
      {
