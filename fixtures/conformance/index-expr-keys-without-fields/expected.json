{
  "metadata.root": {
    "package": "demo::indexing",
    "children": [
      {
        "object.entity": {
          "name": "Notification",
          "children": [
            {
              "source.rdb": {
                "@table": "notifications"
              }
            },
            {
              "field.string": {
                "name": "id",
                "@required": true
              }
            },
            {
              "field.timestamp": {
                "name": "deliveredAt"
              }
            },
            {
              "field.string": {
                "name": "payload"
              }
            },
            {
              "identity.primary": {
                "name": "pk",
                "@fields": [
                  "id"
                ]
              }
            },
            {
              "index.lookup": {
                "name": "pendingDeviceIdx",
                "@expr": "(payload->>'device_id')",
                "@where": "delivered_at IS NULL"
              }
            },
            {
              "identity.secondary": {
                "name": "lowerIdUk",
                "@expr": "lower(id)"
              }
            }
          ]
        }
      }
    ]
  }
}

