{
  "metadata.root": {
    "package": "acme::purchasing",
    "children": [
      {
        "object.entity": {
          "name": "PurchaseRequest",
          "children": [
            {
              "source.rdb": {
                "@table": "purchase_requests"
              }
            },
            {
              "field.long": {
                "name": "id"
              }
            },
            {
              "identity.primary": {
                "name": "pk",
                "@fields": [
                  "id"
                ]
              }
            },
            {
              "field.string": {
                "name": "title"
              }
            },
            {
              "field.enum": {
                "name": "status",
                "@default": "draft",
                "@values": [
                  "draft",
                  "submitted",
                  "approved",
                  "rejected"
                ],
                "children": [
                  {
                    "transition.action": {
                      "name": "submit",
                      "@from": [
                        "draft"
                      ],
                      "@to": "submitted"
                    }
                  },
                  {
                    "transition.action": {
                      "name": "approve",
                      "@from": [
                        "submitted"
                      ],
                      "@to": "approved"
                    }
                  },
                  {
                    "transition.action": {
                      "name": "reject",
                      "@from": [
                        "submitted"
                      ],
                      "@to": "rejected"
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "api.operational": {
          "name": "PurchasingV1",
          "children": [
            {
              "operation.query": {
                "name": "openRequests",
                "@many": true,
                "@outputRef": "acme::purchasing::PurchaseRequest",
                "@permission": "purchasing.openRequests",
                "children": [
                  {
                    "binding.rest": {
                      "@path": "/v1/open-requests"
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "api.operational": {
          "name": "PurchasingV2",
          "children": [
            {
              "operation.query": {
                "name": "openRequests",
                "@many": true,
                "@outputRef": "acme::purchasing::PurchaseRequest",
                "@permission": "purchasing.openRequests",
                "children": [
                  {
                    "binding.rest": {
                      "@path": "/v2/open-requests"
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
