{
  "metadata.root": {
    "package": "acme::views",
    "children": [
      { "object.value": { "name": "Contact", "children": [
        { "field.string": { "name": "kind" } },
        { "field.int": { "name": "rank" } }
      ] } },
      { "object.entity": { "name": "Customer", "children": [
        { "source.rdb": { "@table": "customers" } },
        { "field.long": { "name": "id" } },
        { "field.string": { "name": "zip", "@dbColumnType": "varchar(10)" } },
        { "field.string": { "name": "code", "@dbColumnType": "character(3)" } },
        { "field.string": { "name": "note", "@dbColumnType": "varchar" } },
        { "field.object": { "name": "contacts", "@objectRef": "Contact", "isArray": true, "@storage": "jsonb" } },
        { "identity.primary": { "name": "id", "@fields": "id" } },
        { "field.string": { "name": "tier", "children": [
          { "origin.function": { "@function": "tier_of", "@schema": "app", "@args": ["id", "zip"] } }
        ] } }
      ] } },
      { "object.entity": { "name": "Order", "children": [
        { "source.rdb": { "@table": "orders" } },
        { "field.long": { "name": "id" } },
        { "field.long": { "name": "customerId" } },
        { "field.enum": { "name": "status", "@values": ["Open", "Shipped"], "@intValueMap": { "Open": 0, "Shipped": 1 } } },
        { "field.int": { "name": "stage" } },
        { "field.timestamp": { "name": "updatedAt" } },
        { "identity.primary": { "name": "id", "@fields": "id" } },
        { "identity.reference": { "name": "customerId", "@fields": "customerId", "@references": "Customer" } }
      ] } },
      { "object.entity": { "name": "OrderEvent", "children": [
        { "source.rdb": { "@table": "order_events" } },
        { "field.long": { "name": "id" } },
        { "field.long": { "name": "orderId" } },
        { "field.long": { "name": "customerId" } },
        { "field.timestamp": { "name": "createdAt" } },
        { "identity.primary": { "name": "id", "@fields": "id" } },
        { "identity.reference": { "name": "orderId", "@fields": "orderId", "@references": "Order" } }
      ] } },
      { "object.projection": { "name": "OrderRow", "children": [
        { "source.rdb": { "@kind": "view", "@view": "v_order_row" } },
        { "field.long": { "name": "id", "extends": "Order.id" } },
        { "field.int": { "name": "outcome", "children": [ { "origin.computed": { "@expr": {
          "case": [ { "when": { "op": "eq", "left": { "field": "stage" }, "right": { "value": 0 } },
                      "then": { "cast": { "field": "status" }, "as": "int" } } ],
          "else": { "field": "stage" } } } } ] } },
        { "field.string": { "name": "zip5", "children": [ { "origin.computed": { "@expr": {
          "fn": "splitPart", "args": [ { "field": "customerId.zip" }, { "value": "-" }, { "value": 1 } ] } } } ] } },
        { "field.string": { "name": "nothing", "children": [ { "origin.computed": { "@expr": {
          "cast": { "value": null }, "as": "string", "dbColumnType": "varchar" } } } ] } },
        { "field.string": { "name": "tier", "children": [ { "origin.passthrough": { "@from": "Customer.tier", "@via": "Order.customerId" } } ] } },
        { "field.timestamp": { "name": "lastEvent", "children": [ { "origin.aggregate": { "@agg": "max", "@of": "OrderEvent.createdAt", "@via": "Order.orderEvents" } } ] } },
        { "field.timestamp": { "name": "touched", "children": [ { "origin.computed": { "@expr": {
          "fn": "greatest", "args": [ { "field": "updatedAt" }, { "field": "lastEvent" } ] } } } ] } },
        { "field.long": { "name": "eventOfCustomer", "children": [ { "origin.first": { "@of": "OrderEvent.id", "@via": "Order.orderEvents",
          "@orderBy": ["createdAt"], "@filter": { "customerId": { "eq": { "field": "customerId.id" } } } } } ] } },
        { "identity.primary": { "name": "id", "extends": "Order.id" } }
      ] } },
      { "object.projection": { "name": "CustomerContact", "@grain": "contacts", "@grainOrdinal": "position", "children": [
        { "source.rdb": { "@kind": "view", "@view": "v_customer_contact" } },
        { "field.long": { "name": "customerId", "extends": "Customer.id" } },
        { "field.int": { "name": "position" } },
        { "field.string": { "name": "kind", "children": [ { "origin.passthrough": { "@from": "Contact.kind" } } ] } }
      ] } },
      { "object.projection": { "name": "CustomerBranch", "abstract": true, "children": [
        { "field.long": { "name": "personId", "extends": "Customer.id" } },
        { "field.string": { "name": "label", "children": [ { "origin.computed": { "@expr": { "fn": "lower", "args": [ { "field": "zip" } ] } } } ] } }
      ] } },
      { "object.projection": { "name": "OrderBranch", "abstract": true, "children": [
        { "field.long": { "name": "personId", "extends": "Order.customerId" } },
        { "field.string": { "name": "label", "children": [ { "origin.computed": { "@expr": { "cast": { "field": "id" }, "as": "string" } } } ] } }
      ] } },
      { "object.projection": { "name": "People", "extends": "CustomerBranch", "@union": ["OrderBranch"], "@unionAll": true, "children": [
        { "source.rdb": { "@kind": "view", "@view": "v_people" } }
      ] } }
    ]
  }
}
