{
  "metadata.root": {
    "package": "acme::purchasing",
    "children": [
      {
        "object.entity": {
          "name": "PurchaseRequest",
          "children": [
            {
              "source.rdb": {
                "@table": "purchase_requests"
              }
            },
            {
              "field.long": {
                "name": "id"
              }
            },
            {
              "identity.primary": {
                "name": "pk",
                "@fields": [
                  "id"
                ]
              }
            },
            {
              "field.string": {
                "name": "title"
              }
            },
            {
              "field.long": {
                "name": "amountCents"
              }
            },
            {
              "field.enum": {
                "name": "status",
                "@values": [
                  "draft",
                  "submitted",
                  "approved",
                  "rejected"
                ],
                "@default": "draft",
                "children": [
                  {
                    "transition.action": {
                      "name": "submit",
                      "@from": [
                        "draft"
                      ],
                      "@to": "submitted"
                    }
                  },
                  {
                    "transition.action": {
                      "name": "approve",
                      "@from": [
                        "submitted"
                      ],
                      "@to": "approved",
                      "@condition": {
                        "op": "gt",
                        "left": {
                          "field": "amountCents"
                        },
                        "right": {
                          "value": 0
                        }
                      }
                    }
                  },
                  {
                    "transition.action": {
                      "name": "reject",
                      "@from": [
                        "submitted"
                      ],
                      "@to": "rejected",
                      "@permission": "purchasing.review"
                    }
                  }
                ]
              }
            },
            {
              "field.enum": {
                "name": "payment",
                "@values": [
                  "unpaid",
                  "paid"
                ],
                "@default": "unpaid",
                "children": [
                  {
                    "transition.action": {
                      "name": "submit",
                      "@from": [
                        "unpaid"
                      ],
                      "@to": "paid"
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
