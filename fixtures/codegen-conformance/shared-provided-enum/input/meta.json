        { "identity.primary": { "name": "pk", "@fields": ["id"] } }
      ] } },
      { "object.entity": { "name": "Refund", "children": [
        { "field.long": { "name": "id" } },
        { "field.enum": { "name": "unit", "extends": "acme::shop::Invoice.money" } },
        { "field.enum": { "name": "tender", "extends": "acme::shop::Ticket.currency" } },
        { "field.enum": { "name": "orderStatus", "extends": "acme::shop::Order.status" } },
        { "field.enum": { "name": "ticketTier", "extends": "acme::shop::Ticket.tier" } },
        { "field.enum": { "name": "invoiceTier", "extends": "acme::shop::Invoice.tier" } },
        { "source.rdb": { "@table": "refunds" } },
        { "identity.primary": { "name": "pk", "@fields": ["id"] } }
      ] } },
      { "object.projection": { "name": "TicketSummary", "children": [
