      { "field.enum": { "name": "Money", "abstract": true, "extends": "Currency" } },
      { "object.entity": { "name": "Ticket", "children": [
        { "field.long": { "name": "id" } },
        { "field.enum": { "name": "priority", "extends": "Priority" } },
        { "field.enum": { "name": "severity", "extends": "Priority" } },
        { "field.enum": { "name": "tier", "extends": "Priority" } },
        { "field.enum": { "name": "currency", "extends": "Currency" } },
        { "source.rdb": { "@table": "tickets" } },
        { "identity.primary": { "name": "pk", "@fields": ["id"] } }
      ] } },
      { "object.entity": { "name": "Order", "children": [
        { "field.long": { "name": "id" } },
        { "field.enum": { "name": "priority", "extends": "Priority" } },
        { "field.enum": { "name": "status", "@values": ["NEW", "PAID"] } },
