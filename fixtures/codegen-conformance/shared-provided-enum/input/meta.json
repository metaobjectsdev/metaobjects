        { "field.long": { "name": "id", "extends": "acme::shop::Ticket.id" } },
        { "field.enum": { "name": "level", "extends": "acme::shop::Ticket.severity" } },
        { "identity.primary": { "name": "pk", "extends": "acme::shop::Ticket.pk" } }
      ] } },
      { "object.value": { "name": "TicketBadge", "children": [
