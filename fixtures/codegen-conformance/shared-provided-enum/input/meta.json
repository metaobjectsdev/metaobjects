        { "field.enum": { "name": "phase", "extends": "acme::shop::Task.phase" } },
        { "field.enum": { "name": "weight", "extends": "acme::shop::Task.weight" } },
        { "source.rdb": { "@table": "subtasks" } },
        { "identity.primary": { "name": "pk", "@fields": ["id"] } }
      ] } },
      { "object.entity": { "name": "Invoice", "children": [
        { "field.long": { "name": "id" } },
        { "field.enum": { "name": "money", "extends": "Money" } },
        { "field.enum": { "name": "tier", "extends": "Money" } },
