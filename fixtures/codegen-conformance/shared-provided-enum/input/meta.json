        { "field.enum": { "name": "phase", "extends": "acme::shop::Ticket.tier", "@values": ["OPEN", "DONE"] } },
        { "field.enum": { "name": "weight", "extends": "acme::shop::Ticket.severity", "@intValueMap": { "LOW": 1, "MEDIUM": 2, "HIGH": 3 } } },
        { "source.rdb": { "@table": "tasks" } },
        { "identity.primary": { "name": "pk", "@fields": ["id"] } }
      ] } },
      { "object.entity": { "name": "Subtask", "children": [
        { "field.long": { "name": "id" } },
