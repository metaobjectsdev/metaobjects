{
  "gadgets": [
    {
      "name": "gadgets_status_chk",
      "expression": "\"status\" IN ('DRAFT', 'LIVE')"
    },
    {
      "name": "gadgets_level_chk",
      "expression": "\"level\" IN (1, 2)"
    },
    {
      "name": "gadgets_score_numeric_chk",
      "expression": "\"score\" >= 1 AND \"score\" <= 5"
    },
    {
      "name": "gadgets_floor_numeric_chk",
      "expression": "\"floor\" >= 0"
    },
    {
      "name": "gadgets_code_length_chk",
      "expression": "length(\"code\") >= 2"
    },
    {
      "name": "gadgets_label_length_chk",
      "expression": "length(\"label\") <= 30"
    },
    {
      "name": "gadgets_sku_shape",
      "expression": "\"sku\" ~ '^[A-Z]{3}-''\\d+$'"
    },
    {
      "name": "gadgets_channel_chk",
      "expression": "\"channel\" IN ('EMAIL', 'SMS')"
    },
    {
      "name": "gadgets_channel_length_chk",
      "expression": "length(\"channel\") >= 1 AND length(\"channel\") <= 5"
    },
    {
      "name": "gadgets_ref_fits",
      "expression": "length(\"ref\") <= 10"
    },
    {
      "name": "gadgets_rank_numeric_chk",
      "expression": "\"rank\" <= 99"
    },
    {
      "name": "gadgets_starts_at_cmp_chk",
      "expression": "\"starts_at\" <= \"ends_at\""
    },
    {
      "name": "gadgets_ends_at_cmp_chk",
      "expression": "((\"status\" <> 'LIVE') OR (\"level\" IS NULL)) OR (\"ends_at\" > \"starts_at\")"
    },
    {
      "name": "gadgets_notes_reqwhen_chk",
      "expression": "(\"kind\" IS DISTINCT FROM 'custom') OR (\"notes\" IS NOT NULL)"
    },
    {
      "name": "gadgets_reason_reqwhen_chk",
      "expression": "(\"timeout\" IS DISTINCT FROM '01:30:00') OR (\"reason\" IS NOT NULL)"
    },
    {
      "name": "gadgets_shipped_at_presentiff_chk",
      "expression": "(\"shipped_at\" IS NOT NULL) = (\"shipped\" IS NOT DISTINCT FROM TRUE)"
    },
    {
      "name": "gadgets_email_atleastone_chk",
      "expression": "num_nonnulls(\"email\", \"phone\") = 1"
    },
    {
      "name": "gadgets_phone_atleastone_chk",
      "expression": "(\"level\" <> 2) OR (\"phone\" IS NOT NULL OR \"fax\" IS NOT NULL)"
    }
  ]
}
