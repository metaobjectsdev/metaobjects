{
  "gadgets": [
    {
      "name": "gadgets_status_chk",
      "expression": "\"status\" IN ('DRAFT', 'LIVE')"
    },
    {
      "name": "gadgets_level_chk",
      "expression": "\"level\" IN (1, 2)"
    },
    {
      "name": "gadgets_score_numeric_chk",
      "expression": "\"score\" >= 1 AND \"score\" <= 5"
    },
    {
      "name": "gadgets_floor_numeric_chk",
      "expression": "\"floor\" >= 0"
    },
    {
      "name": "gadgets_code_length_chk",
      "expression": "length(\"code\") >= 2 AND length(\"code\") <= 20"
    },
    {
      "name": "gadgets_label_length_chk",
      "expression": "length(\"label\") >= 0 AND length(\"label\") <= 30"
    },
    {
      "name": "gadgets_sku_shape",
      "expression": "\"sku\" ~ '^[A-Z]{3}-''\\d+$'"
    },
    {
      "name": "gadgets_channel_chk",
      "expression": "\"channel\" IN ('EMAIL', 'SMS')"
    },
    {
      "name": "gadgets_channel_length_chk",
      "expression": "length(\"channel\") >= 1 AND length(\"channel\") <= 5"
    },
    {
      "name": "gadgets_ref_fits",
      "expression": "length(\"ref\") <= 10"
    },
    {
      "name": "gadgets_rank_numeric_chk",
      "expression": "\"rank\" <= 99"
    },
    {
      "name": "gadgets_starts_at_cmp_chk",
      "expression": "\"starts_at\" <= \"ends_at\""
    },
    {
      "name": "gadgets_ends_at_cmp_chk",
      "expression": "((\"status\" <> 'LIVE') OR (\"level\" IS NULL)) OR (\"ends_at\" > \"starts_at\")"
    },
    {
      "name": "gadgets_notes_reqwhen_chk",
      "expression": "(\"kind\" IS DISTINCT FROM 'custom') OR (\"notes\" IS NOT NULL)"
    },
    {
      "name": "gadgets_reason_reqwhen_chk",
      "expression": "(\"timeout\" IS DISTINCT FROM '01:30:00') OR (\"reason\" IS NOT NULL)"
    },
    {
      "name": "gadgets_shipped_at_presentiff_chk",
      "expression": "(\"shipped_at\" IS NOT NULL) = (\"shipped\" IS NOT DISTINCT FROM TRUE)"
    },
    {
      "name": "gadgets_email_atleastone_chk",
      "expression": "num_nonnulls(\"email\", \"phone\") = 1"
    },
    {
      "name": "gadgets_phone_atleastone_chk",
      "expression": "(\"level\" <> 2) OR (\"phone\" IS NOT NULL OR \"fax\" IS NOT NULL)"
    }
  ],
  "jobs": [
    {
      "name": "jobs_status_chk",
      "expression": "\"status\" IN ('q_queued', 'q_done', 'q_failed')"
    },
    {
      "name": "jobs_error_reqwhen_chk",
      "expression": "(\"status\" IS DISTINCT FROM 'q_failed') OR (\"error\" IS NOT NULL)"
    },
    {
      "name": "jobs_done_at_cmp_chk",
      "expression": "(\"status\" <> 'q_done') OR (\"done_at\" >= \"started_at\")"
    }
  ],
  "devices": [
    {
      "name": "devices_kind_chk",
      "expression": "\"kind\" IN ('METER', 'SENSOR', 'SMART_METER', 'SWITCH')"
    },
    {
      "name": "devices_voltage_numeric_chk",
      "expression": "\"voltage\" >= 1 AND \"voltage\" <= 480"
    },
    {
      "name": "devices_meter_serial_regex_chk",
      "expression": "((\"kind\" <> 'METER') AND (\"kind\" <> 'SMART_METER')) OR (\"serial\" ~ '^M[0-9]+$')"
    },
    {
      "name": "devices_sensor_serial_regex_chk",
      "expression": "(\"kind\" <> 'SENSOR') OR (\"serial\" ~ '^S[0-9]+$')"
    },
    {
      "name": "devices_meter_grade_chk",
      "expression": "((\"kind\" <> 'METER') AND (\"kind\" <> 'SMART_METER')) OR (\"grade\" IN ('A', 'B'))"
    },
    {
      "name": "devices_switch_grade_chk",
      "expression": "(\"kind\" <> 'SWITCH') OR (\"grade\" IN ('X', 'Y'))"
    },
    {
      "name": "devices_note_length_chk",
      "expression": "length(\"note\") <= 40"
    },
    {
      "name": "devices_mode_chk",
      "expression": "\"mode\" IN ('AUTO', 'MANUAL')"
    },
    {
      "name": "devices_firmware_length_chk",
      "expression": "length(\"firmware\") >= 1"
    },
    {
      "name": "devices_label_length_chk",
      "expression": "length(\"label\") >= 1 AND length(\"label\") <= 12"
    },
    {
      "name": "devices_powered_voltage_atleastone_chk",
      "expression": "((\"kind\" <> 'METER') AND (\"kind\" <> 'SENSOR') AND (\"kind\" <> 'SMART_METER')) OR (\"voltage\" IS NOT NULL OR \"watts\" IS NOT NULL)"
    },
    {
      "name": "devices_sensor_unit_reqwhen_chk",
      "expression": "(\"kind\" <> 'SENSOR') OR ((\"mode\" IS DISTINCT FROM 'MANUAL') OR (\"unit\" IS NOT NULL))"
    },
    {
      "name": "devices_sensor_note_reqwhen_chk",
      "expression": "(\"kind\" <> 'SENSOR') OR ((\"mode\" IS DISTINCT FROM 'MANUAL') OR (\"note\" IS NOT NULL))"
    },
    {
      "name": "devices_smartmeter_firmware_reqwhen_chk",
      "expression": "(\"kind\" <> 'SMART_METER') OR ((\"grade\" IS DISTINCT FROM 'A') OR (\"firmware\" IS NOT NULL))"
    },
    {
      "name": "devices_switch_label_cmp_chk",
      "expression": "((\"kind\" <> 'SWITCH') OR (\"label\" IS NULL)) OR (\"label\" <> \"kind\")"
    },
    {
      "name": "devices_switch_note_reqwhen_chk",
      "expression": "(\"kind\" <> 'SWITCH') OR ((\"legacy_position\" IS DISTINCT FROM 'OFF') OR (\"note\" IS NOT NULL))"
    }
  ]
}
