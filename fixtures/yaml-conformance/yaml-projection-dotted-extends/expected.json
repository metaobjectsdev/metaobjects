{
  "metadata.root": {
    "package": "demo",
    "children": [
      {
        "object.entity": {
          "name": "Customer",
          "children": [
            {
              "field.uuid": {
                "name": "id"
              }
            },
            {
              "field.currency": {
                "name": "priceCents",
                "@currency": "USD",
                "children": [
                  {
                    "view.currency": {
                      "name": "display",
                      "@locale": "en-US"
                    }
                  }
                ]
              }
            },
            {
              "identity.primary": {
                "name": "id",
                "@fields": [
                  "id"
                ]
              }
            }
          ]
        }
      },
      {
        "object.projection": {
          "name": "CustomerPricesV1",
          "children": [
            {
              "field.uuid": {
                "name": "customerId",
                "extends": "demo::Customer.id",
                "@column": "customer_id"
              }
            },
            {
              "field.currency": {
                "name": "price",
                "extends": "demo::Customer.priceCents",
                "@column": "price_cents",
                "children": [
                  {
                    "view.currency": {
                      "name": "display",
                      "extends": "demo::Customer.priceCents.display"
                    }
                  }
                ]
              }
            },
            {
              "identity.primary": {
                "name": "id",
                "extends": "demo::Customer.id"
              }
            }
          ]
        }
      }
    ]
  }
}
