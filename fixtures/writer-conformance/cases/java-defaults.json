{
  "description": "The Java dialect indents four spaces, breaks at 120 columns and puts no comma after the last item of a broken list.",
  "dialect": "java",
  "ops": [
    [
      "open",
      "class A {"
    ],
    [
      "line",
      "static final List<String> NAMES = ",
      {
        "list": {
          "open": "List.of(",
          "items": [
            "\"n00\"",
            "\"n01\"",
            "\"n02\"",
            "\"n03\"",
            "\"n04\"",
            "\"n05\"",
            "\"n06\"",
            "\"n07\"",
            "\"n08\"",
            "\"n09\"",
            "\"n10\"",
            "\"n11\"",
            "\"n12\"",
            "\"n13\""
          ],
          "close": ")"
        }
      },
      ";"
    ],
    [
      "close",
      "}"
    ]
  ],
  "expected": [
    "class A {",
    "    static final List<String> NAMES = List.of(",
    "        \"n00\",",
    "        \"n01\",",
