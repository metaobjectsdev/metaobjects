{
  "description": "The indent counts toward the width: the same line fits at the root and breaks inside a block.",
  "dialect": "core",
  "options": {
    "indent": "  ",
    "width": 19,
    "trailingComma": true
  },
  "ops": [
    [
      "line",
      "f",
      {
