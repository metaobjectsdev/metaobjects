            "bbbbbb"
          ],
          "close": ")"
        }
      },
      ";"
    ],
    [
      "open",
      "{"
    ],
    [
      "line",
      "f",
      {
        "list": {
          "open": "(",
          "items": [
            "aaaaaa",
            "bbbbbb"
          ],
          "close": ")"
        }
      },
      ";"
    ],
    [
      "close",
      "}"
