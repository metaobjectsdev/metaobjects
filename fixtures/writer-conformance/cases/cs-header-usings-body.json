{
  "description": "Header lines print first, then the collected using directives (each once, in the order named), a blank line, then the body written with the C# defaults.",
  "dialect": "csharp",
  "ops": [
    [
      "header",
      "// <auto-generated/>",
      "#nullable enable"
    ],
    [
      "using",
      "System.Collections.Generic"
    ],
    [
      "using",
      "System"
    ],
    [
      "using",
      "System.Collections.Generic"
    ],
    [
      "line",
      "namespace Demo;"
    ],
    [
      "blank"
    ],
    [
      "line",
      "public static class A"
    ],
    [
      "open",
      "{"
    ],
    [
      "line",
      "public static int X;"
    ],
    [
      "close",
      "}"
    ]
  ],
  "expected": [
    "// <auto-generated/>",
    "#nullable enable",
    "using System.Collections.Generic;",
    "using System;",
    "",
    "namespace Demo;",
    "",
    "public static class A",
    "{",
    "    public static int X;",
    "}"
  ]
}
