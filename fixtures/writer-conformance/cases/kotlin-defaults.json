{
  "description": "The Kotlin dialect indents four spaces, breaks at 120 columns and puts a comma after the last item of a broken list, as Kotlin's coding conventions write it.",
  "dialect": "kotlin",
  "ops": [
    [
      "open",
      "object A {"
    ],
    [
      "line",
      "val NAMES: List<String> = ",
      {
        "list": {
          "open": "listOf(",
          "items": [
            "\"n00\"",
            "\"n01\"",
            "\"n02\"",
            "\"n03\"",
            "\"n04\"",
            "\"n05\"",
            "\"n06\"",
            "\"n07\"",
            "\"n08\"",
            "\"n09\"",
            "\"n10\"",
            "\"n11\"",
            "\"n12\"",
            "\"n13\""
          ],
          "close": ")"
        }
      }
    ],
    [
      "close",
      "}"
    ]
  ],
  "expected": [
    "object A {",
    "    val NAMES: List<String> = listOf(",
    "        \"n00\",",
    "        \"n01\",",
    "        \"n02\",",
    "        \"n03\",",
    "        \"n04\",",
    "        \"n05\",",
    "        \"n06\",",
    "        \"n07\",",
    "        \"n08\",",
    "        \"n09\",",
    "        \"n10\",",
    "        \"n11\",",
    "        \"n12\",",
    "        \"n13\",",
    "    )",
    "}"
  ]
}
