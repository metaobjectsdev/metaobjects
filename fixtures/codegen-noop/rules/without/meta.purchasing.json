              "field.long": {
                "name": "requestId",
                "extends": "PurchaseRequest.id"
              }
            },
            {
              "field.string": {
                "name": "comment"
              }
            }
          ]
        }
      },
      {
        "object.projection": {
          "name": "RequestSummary",
          "children": [
            {
              "source.rdb": {
                "@kind": "view",
                "@view": "v_request_summary"
              }
            },
            {
              "field.long": {
                "name": "id",
                "extends": "PurchaseRequest.id"
              }
            },
            {
              "field.string": {
                "name": "title",
                "extends": "PurchaseRequest.title"
              }
            },
            {
              "identity.primary": {
                "name": "pk",
                "extends": "PurchaseRequest.pk"
              }
            }
          ]
        }
      }
    ]
  }
}
