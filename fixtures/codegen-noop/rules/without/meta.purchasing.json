              "source.rdb": {
                "@table": "purchase_requests"
              }
            },
            {
              "field.long": {
                "name": "id"
              }
            },
            {
              "identity.primary": {
                "name": "pk",
                "@fields": [
                  "id"
                ]
              }
            },
            {
              "field.string": {
                "name": "title"
              }
            },
            {
              "field.long": {
