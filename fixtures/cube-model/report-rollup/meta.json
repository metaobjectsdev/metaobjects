{
  "metadata.root": {
    "package": "shop",
    "children": [
      {
        "object.entity": {
          "name": "Program",
          "children": [
            {
              "source.rdb": {
                "@table": "programs"
              }
            },
            {
              "field.long": {
                "name": "id"
              }
            },
            {
              "field.enum": {
                "name": "status",
                "@values": [
                  "DRAFT",
                  "PUBLISHED"
                ]
              }
            },
            {
              "field.timestamp": {
                "name": "createdAt"
              }
            },
            {
              "field.currency": {
                "name": "priceCents",
                "@currency": "USD"
              }
            },
            {
              "identity.primary": {
                "name": "id",
                "@fields": "id"
              }
            },
            {
              "dimension.attribute": {
                "name": "status",
                "@of": "Program.status"
              }
            },
            {
              "dimension.time": {
                "name": "createdAt",
                "@of": "Program.createdAt",
                "@grains": [
                  "month"
                ]
              }
            },
            {
              "measure.aggregate": {
                "name": "programs",
                "@agg": "count",
                "@of": "Program.id"
              }
            },
            {
              "measure.aggregate": {
                "name": "listValue",
                "@agg": "sum",
                "@of": "Program.priceCents"
              }
            },
            {
              "segment.filter": {
                "name": "published",
                "@filter": {
                  "status": "PUBLISHED"
                }
              }
            }
          ]
        }
      },
      {
        "object.report": {
          "name": "ProgramsByMonth",
          "@from": "Program",
          "@dimensions": [
            "createdAt:month",
            "status"
          ],
          "@measures": [
            "programs",
            "listValue"
          ],
          "@segment": "published",
          "@filter": {
            "priceCents": {
              "gt": 0
            }
          },
          "children": [
            {
              "source.rdb": {
                "@kind": "view",
                "@view": "v_programsbymonth"
              }
            }
          ]
        }
      },
      {
        "object.report": {
          "name": "ProgramTotals",
          "@from": "Program",
          "@measures": [
            "programs"
          ],
          "children": [
            {
              "source.rdb": {
                "@kind": "view",
                "@view": "v_programtotals"
              }
            }
          ]
        }
      }
    ]
  }
}
