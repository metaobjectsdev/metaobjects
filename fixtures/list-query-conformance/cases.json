    {
      "group": "combinators",
      "name": "or-one-branch-is-the-branch",
      "query": "filter[or][0][status][eq]=closed",
      "why": "an or of one branch is that branch",
      "expect": {
        "list": {
          "filter": {
            "field": "status",
            "op": "eq",
            "value": "closed"
          }
        }
      }
    },
    {
      "group": "combinators",
      "name": "or-beside-a-field",
      "query": "filter[active][eq]=true&filter[or][0][status][eq]=open&filter[or][1][status][eq]=pending",
      "why": "an or beside a field is ANDed with it",
      "expect": {
        "list": {
          "filter": {
            "and": [
              {
                "field": "active",
                "op": "eq",
                "value": true
              },
              {
                "or": [
                  {
                    "field": "status",
                    "op": "eq",
                    "value": "open"
                  },
                  {
                    "field": "status",
                    "op": "eq",
                    "value": "pending"
                  }
                ]
              }
            ]
          }
        }
      }
    },
    {
      "group": "combinators",
      "name": "or-branch-with-two-conditions",
      "query": "filter[or][0][status][eq]=open&filter[or][0][priority][gt]=3&filter[or][1][active][eq]=false",
      "why": "a branch with two conditions is their and",
      "expect": {
        "list": {
          "filter": {
            "or": [
              {
                "and": [
                  {
                    "field": "status",
                    "op": "eq",
                    "value": "open"
                  },
                  {
                    "field": "priority",
                    "op": "gt",
                    "value": 3
                  }
                ]
              },
              {
                "field": "active",
                "op": "eq",
                "value": false
              }
            ]
          }
        }
      }
    },
    {
      "group": "combinators",
