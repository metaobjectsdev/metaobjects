        "list": {
          "filter": {
            "and": [
              {
                "field": "status",
                "op": "eq",
                "value": "open"
              },
              {
                "field": "active",
                "op": "eq",
                "value": true
              }
            ]
          }
        }
      }
    },
    {
      "group": "combinators",
      "name": "or-two-branches",
      "query": "filter[or][0][status][eq]=closed&filter[or][1][priority][eq]=5",
