{
  "cases": [
    {
      "group": "operators",
      "name": "eq-text",
      "query": "filter[title][eq]=Pump",
      "why": "eq on a text field keeps the value as sent",
      "expect": {
        "list": {
          "filter": {
            "field": "title",
            "op": "eq",
            "value": "Pump"
          }
        }
      }
    },
    {
      "group": "operators",
      "name": "eq-bare-value-sugar",
      "query": "filter[title]=Pump",
      "why": "a bare filter value is eq",
      "expect": {
        "list": {
          "filter": {
            "field": "title",
            "op": "eq",
            "value": "Pump"
          }
        }
      }
    },
    {
      "group": "operators",
      "name": "ne-text",
      "query": "filter[code][ne]=T-001",
      "why": "ne on a text field",
      "expect": {
        "list": {
          "filter": {
            "field": "code",
            "op": "ne",
            "value": "T-001"
          }
        }
      }
    },
    {
      "group": "operators",
      "name": "gt-integer",
      "query": "filter[priority][gt]=2",
      "why": "an integer operand is a JSON number",
      "expect": {
        "list": {
          "filter": {
            "field": "priority",
            "op": "gt",
            "value": 2
          }
        }
      }
    },
    {
      "group": "operators",
      "name": "gte-double",
      "query": "filter[score][gte]=1.5",
      "why": "a double operand is a JSON number",
      "expect": {
        "list": {
          "filter": {
            "field": "score",
            "op": "gte",
            "value": 1.5
          }
        }
      }
    },
    {
      "group": "operators",
      "name": "lt-date",
      "query": "filter[dueOn][lt]=2026-03-01",
      "why": "a date operand is kept as sent",
      "expect": {
        "list": {
          "filter": {
            "field": "dueOn",
            "op": "lt",
            "value": "2026-03-01"
          }
        }
      }
    },
    {
      "group": "operators",
      "name": "lte-time",
      "query": "filter[opensAt][lte]=09:30",
      "why": "a time operand is kept as sent",
      "expect": {
        "list": {
          "filter": {
            "field": "opensAt",
            "op": "lte",
            "value": "09:30"
          }
        }
      }
    },
    {
      "group": "operators",
      "name": "in-text",
      "query": "filter[status][in]=open,closed",
      "why": "in splits on commas",
      "expect": {
        "list": {
          "filter": {
            "field": "status",
            "op": "in",
            "value": [
              "open",
              "closed"
            ]
          }
        }
      }
    },
    {
      "group": "operators",
      "name": "in-integers-trimmed",
      "query": "filter[priority][in]=1,%202,3",
      "why": "each in element is trimmed and typed",
      "expect": {
        "list": {
          "filter": {
            "field": "priority",
            "op": "in",
            "value": [
              1,
              2,
              3
            ]
          }
        }
      }
    },
    {
      "group": "operators",
      "name": "like-trailing-wildcard",
      "query": "filter[title][like]=Pu%25",
      "why": "a like pattern is kept verbatim",
      "expect": {
        "list": {
          "filter": {
            "field": "title",
            "op": "like",
            "value": "Pu%"
          }
        }
      }
    },
    {
      "group": "operators",
      "name": "like-underscore",
      "query": "filter[code][like]=T-0_1",
      "why": "_ is a wildcard and is kept",
      "expect": {
        "list": {
          "filter": {
            "field": "code",
            "op": "like",
            "value": "T-0_1"
          }
        }
      }
    },
    {
      "group": "operators",
      "name": "isnull-true-filterable",
      "query": "filter[ownerId][isNull]=true",
      "why": "isNull true",
      "expect": {
        "list": {
          "filter": {
            "field": "ownerId",
            "op": "isNull",
            "value": true
          }
        }
      }
    },
    {
      "group": "operators",
      "name": "isnull-false",
      "query": "filter[ownerId][isNull]=false",
      "why": "isNull false",
      "expect": {
        "list": {
          "filter": {
            "field": "ownerId",
            "op": "isNull",
            "value": false
          }
        }
      }
    },
    {
      "group": "operators",
      "name": "isnull-one",
      "query": "filter[dueOn][isNull]=1",
      "why": "1 is true",
      "expect": {
        "list": {
          "filter": {
            "field": "dueOn",
            "op": "isNull",
            "value": true
          }
        }
      }
    },
    {
      "group": "operators",
      "name": "boolean-true",
      "query": "filter[active][eq]=true",
      "why": "a boolean operand is a JSON boolean",
      "expect": {
        "list": {
          "filter": {
            "field": "active",
            "op": "eq",
            "value": true
          }
        }
      }
    },
    {
      "group": "operators",
      "name": "boolean-zero",
      "query": "filter[active][eq]=0",
      "why": "0 is false",
      "expect": {
        "list": {
          "filter": {
            "field": "active",
            "op": "eq",
            "value": false
          }
        }
      }
    },
    {
      "group": "operators",
      "name": "enum-member",
      "query": "filter[status][eq]=pending",
      "why": "an enum member",
      "expect": {
        "list": {
          "filter": {
            "field": "status",
            "op": "eq",
            "value": "pending"
          }
        }
      }
    },
    {
      "group": "operators",
      "name": "int-enum-member",
      "query": "filter[severity][in]=low,high",
      "why": "an int-backed enum is filtered by member symbol",
      "expect": {
        "list": {
          "filter": {
            "field": "severity",
            "op": "in",
            "value": [
              "low",
              "high"
            ]
          }
        }
      }
    },
    {
      "group": "operators",
      "name": "int-enum-no-like",
      "query": "filter[severity][like]=lo%25",
      "why": "an int-backed enum has no like",
      "expect": {
        "error": {
          "error": "invalid_filter_op",
          "field": "severity",
          "op": "like",
          "allowed": [
            "eq",
            "ne",
            "in",
            "isNull"
          ]
        }
      }
    },
    {
      "group": "operators",
      "name": "currency-integer",
      "query": "filter[feeCents][gte]=1500",
      "why": "currency is integer minor units",
      "expect": {
        "list": {
          "filter": {
            "field": "feeCents",
            "op": "gte",
            "value": 1500
          }
        }
      }
    },
    {
      "group": "operators",
      "name": "uuid",
      "query": "filter[ownerId][eq]=6f1c2a9e-0b7d-4c3a-9e2f-1a2b3c4d5e6f",
      "why": "a uuid operand is kept as sent",
      "expect": {
        "list": {
          "filter": {
            "field": "ownerId",
            "op": "eq",
            "value": "6f1c2a9e-0b7d-4c3a-9e2f-1a2b3c4d5e6f"
          }
        }
      }
    },
    {
      "group": "operators",
      "name": "duration",
      "query": "filter[timeSpent][gte]=PT1H30M",
      "why": "a duration operand is kept as sent",
      "expect": {
        "list": {
          "filter": {
            "field": "timeSpent",
            "op": "gte",
            "value": "PT1H30M"
          }
        }
      }
    },
    {
      "group": "canonical-values",
      "name": "decimal-canonical",
      "query": "filter[amount][gt]=10.50",
      "why": "a decimal operand is its canonical text, never a double",
      "expect": {
        "list": {
          "filter": {
            "field": "amount",
            "op": "gt",
            "value": "10.5"
          }
        }
      }
    },
    {
      "group": "canonical-values",
      "name": "decimal-leading-zero",
      "query": "filter[amount][gt]=010.5",
      "why": "a leading zero is not the JSON-number grammar",
      "expect": {
        "error": {
          "error": "invalid_filter_value",
          "field": "amount",
          "op": "gt",
          "expected": "decimal number (digits, optional fraction, optional exponent)"
        }
      }
    },
    {
      "group": "canonical-values",
      "name": "decimal-exponent",
      "query": "filter[amount][lte]=1.5e2",
      "why": "the JSON-number grammar admits an exponent",
      "expect": {
        "list": {
          "filter": {
            "field": "amount",
            "op": "lte",
            "value": "150"
          }
        }
      }
    },
    {
      "group": "canonical-values",
      "name": "timestamp-date-only-is-utc-midnight",
      "query": "filter[createdAt][gte]=2026-10-06",
      "why": "an instant read from a date is midnight UTC",
      "expect": {
        "list": {
          "filter": {
            "field": "createdAt",
            "op": "gte",
            "value": "2026-10-06T00:00:00Z"
          }
        }
      }
    },
    {
      "group": "canonical-values",
      "name": "timestamp-zoneless-is-utc",
      "query": "filter[createdAt][lt]=2026-10-06T08:00:00",
      "why": "an instant with no zone is read as UTC",
      "expect": {
        "list": {
          "filter": {
            "field": "createdAt",
            "op": "lt",
            "value": "2026-10-06T08:00:00Z"
          }
        }
      }
    },
    {
      "group": "canonical-values",
      "name": "timestamp-offset-to-utc",
      "query": "filter[createdAt][lt]=2026-10-06T08:00:00%2B02:00",
      "why": "a zoned instant is rewritten to UTC",
      "expect": {
        "list": {
          "filter": {
            "field": "createdAt",
            "op": "lt",
            "value": "2026-10-06T06:00:00Z"
          }
        }
      }
    },
    {
      "group": "canonical-values",
      "name": "timestamp-local-kept",
      "query": "filter[wallClock][gte]=2026-10-06T08:00:00",
      "why": "a @localTime wall clock is kept as sent",
      "expect": {
        "list": {
          "filter": {
            "field": "wallClock",
            "op": "gte",
            "value": "2026-10-06T08:00:00"
          }
        }
      }
    },
    {
      "group": "canonical-values",
      "name": "timestamp-local-offset-to-utc",
      "query": "filter[wallClock][gte]=2026-10-06T08:00:00-05:00",
      "why": "a zoned bound on a wall clock is still rewritten to UTC",
      "expect": {
        "list": {
          "filter": {
            "field": "wallClock",
            "op": "gte",
            "value": "2026-10-06T13:00:00Z"
          }
        }
      }
    },
    {
      "group": "combinators",
      "name": "two-ops-one-field",
      "query": "filter[priority][gte]=2&filter[priority][lte]=4",
      "why": "two ops on one field AND together",
      "expect": {
        "list": {
          "filter": {
            "and": [
              {
                "field": "priority",
                "op": "gte",
                "value": 2
              },
              {
                "field": "priority",
                "op": "lte",
                "value": 4
              }
            ]
          }
        }
      }
    },
    {
      "group": "combinators",
      "name": "two-fields",
      "query": "filter[status][eq]=open&filter[active][eq]=true",
      "why": "two fields AND together, in the order sent",
