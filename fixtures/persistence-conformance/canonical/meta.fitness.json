{
  "metadata.root": {
    "package": "fitness",
    "children": [
      { "object.entity": {
        "name": "Program",
        "children": [
          { "source.rdb": { "@table": "programs" } },
          { "field.long":     { "name": "id" } },
          { "field.string":   { "name": "title", "@required": true, "@maxLength": 200 } },
          { "field.currency": { "name": "priceCents", "@required": true, "@currency": "USD" } },
          { "field.enum":     { "name": "status",     "@required": true, "@values": ["DRAFT", "PUBLISHED", "ARCHIVED"] } },
          { "field.timestamp": { "name": "createdAt", "@required": true } },
          { "relationship.composition": { "name": "weeks", "@objectRef": "Week", "@cardinality": "many" } },
          { "identity.primary":   { "@fields": "id", "@generation": "increment" } },
          { "identity.secondary": { "name": "byTitle", "@fields": "title", "@unique": true } }
        ]
      }},
      { "object.entity": {
        "name": "Week",
        "children": [
          { "source.rdb": { "@table": "weeks" } },
          { "field.long":   { "name": "id" } },
          { "field.long":   { "name": "programId", "@required": true } },
          { "field.string": { "name": "label", "@maxLength": 80 } },
          { "identity.primary":   { "@fields": "id", "@generation": "increment" } },
          { "identity.reference": { "name": "fkProgram", "@fields": "programId", "@references": "Program" } }
        ]
      }},
      { "object.entity": {
        "name": "Measurement",
        "children": [
          { "source.rdb": { "@table": "measurements" } },
          { "field.long":   { "name": "id" } },
          { "field.float":  { "name": "tempC",  "@required": true } },
          { "field.double": { "name": "massKg", "@required": true } },
          { "identity.primary": { "@fields": "id", "@generation": "increment" } }
        ]
      }},
      { "object.entity": {
        "name": "ProgramView",
        "children": [
          { "source.rdb": { "@kind": "view", "@table": "v_program" } },
          { "field.long":   { "name": "id",     "children": [ { "origin.passthrough": { "@from": "Program.id" } } ] } },
          { "field.string": { "name": "title",  "children": [ { "origin.passthrough": { "@from": "Program.title" } } ] } },
          { "field.enum":   { "name": "status", "@values": ["DRAFT", "PUBLISHED", "ARCHIVED"],
                              "children": [ { "origin.passthrough": { "@from": "Program.status" } } ] } },
          { "identity.primary": { "@fields": "id" } }
        ]
      }},
      { "object.entity": {
        "name": "ProgramStat",
        "children": [
          { "source.rdb": { "@kind": "view", "@table": "v_program_stat" } },
          { "field.long": { "name": "programId",
            "children": [ { "origin.passthrough": { "@from": "Program.id" } } ] } },
          { "field.long": { "name": "weekCount",
            "children": [
              { "origin.aggregate": { "@agg": "count", "@of": "Week.id", "@via": "Program.weeks" } }
          ]}},
          { "identity.primary": { "@fields": "programId" } }
        ]
      }}
    ]
  }
}
